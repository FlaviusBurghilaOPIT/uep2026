# =============================================================================
# RemoteCare Pro — Environment Variables Template
# Copy this file to .env: cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL 16 + pgvector)
# -----------------------------------------------------------------------------
# Local Docker Compose: postgresql://caredev:caredev@db:5432/remotecare
# Local Direct Host:   postgresql://caredev:caredev@localhost:5432/remotecare
# AWS RDS / EC2:       postgresql://<db_user>:<db_pass>@<rds_endpoint>:5432/<db_name>
DATABASE_URL=postgresql://caredev:caredev@db:5432/remotecare
POSTGRES_USER=caredev
POSTGRES_PASSWORD=caredev
POSTGRES_DB=remotecare
POSTGRES_APP_PASSWORD=dev-only-change-in-prod

# -----------------------------------------------------------------------------
# Security & Clinician Authentication
# -----------------------------------------------------------------------------
AUTH_PROVIDER=local
JWT_SECRET=dev-secret-change-in-production-use-strong-secret-key-32chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Demo Clinician & Patient Defaults
CLINICIAN_EMAIL=clinician@example.com
CLINICIAN_PASSWORD=CarePro#2026!Secure
DEMO_PATIENT_EMAIL=patient@example.com

# -----------------------------------------------------------------------------
# AI / LLM Intelligence (Streaming RAG & Clinical Guardrails)
# -----------------------------------------------------------------------------
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-your-openrouter-key-here
OPENROUTER_MODEL=meta-llama/llama-3-8b-instruct
EMBEDDING_MODEL=openai/text-embedding-ada-002
OPENROUTER_TIMEOUT=20

# -----------------------------------------------------------------------------
# Arize Phoenix — LLM Observability, Evaluation & Cost Tracking
# -----------------------------------------------------------------------------
# Phoenix UI Dashboard: http://localhost:6006 (or http://<EC2-IP>:6006)
PHOENIX_COLLECTOR_ENDPOINT=http://phoenix:6006/v1/traces
PHOENIX_PROJECT_NAME=remote-carepro
PHOENIX_ENABLE_AUTH=true
PHOENIX_SECRET=phoenix-super-secret-key-32chars-min
PHOENIX_SECRET_KEY=phoenix-super-secret-key-32chars-min
PHOENIX_ADMIN_EMAIL=admin@localhost
PHOENIX_ADMIN_PASSWORD=Phoenix#2026!Guard

# -----------------------------------------------------------------------------
# External APIs (openFDA Drug Label Intelligence)
# -----------------------------------------------------------------------------
FDA_PROVIDER=live
FDA_TIMEOUT=8

# -----------------------------------------------------------------------------
# Web & Service URLs (Frontend <-> Backend Communication)
# -----------------------------------------------------------------------------
# EC2 / Docker Internal network URL
INTERNAL_API_URL=http://backend:8000
BACKEND_URL=http://backend:8000

# Client browser accessible URL (Change localhost to your EC2 Public IP / Domain in production)
VITE_API_URL=http://localhost:8000

# Web server port & host
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# -----------------------------------------------------------------------------
# AWS Cloud Services (Optional / Production)
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=