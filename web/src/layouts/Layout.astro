---
import { isLanguage } from '../i18n'

interface Props {
  title?: string
  description?: string
}

const cookieLang = Astro.cookies.get('carepro_language')?.value
const lang = isLanguage(cookieLang) ? cookieLang : 'en'

const {
  title = 'RemoteCare Pro — Clinical Triage & Post-Op Recovery Platform',
  description = 'RemoteCare Pro: Post-operative remote care triage, medication adherence, Amazon Bedrock AI safety guardrails, and openFDA drug safety intelligence.'
} = Astro.props
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
