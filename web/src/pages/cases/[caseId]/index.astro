---
import AppLayout from '../../../layouts/AppLayout.astro'
import {
  ArrowLeft,
  Phone,
  Pill,
  Activity,
  Clock,
  AlertTriangle,
  CheckCircle2,
  Calendar,
  Stethoscope,
  HeartPulse,
  FileText,
  ShieldCheck,
  Plus,
  ArrowRight
} from '@lucide/astro'
import { apiFetch } from '../../../api/client'
import { createTranslator, isLanguage } from '../../../i18n'
import '../../../index.css'

const { caseId } = Astro.params

const cookieLang = Astro.cookies.get('carepro_language')?.value
const lang = isLanguage(cookieLang) ? cookieLang : 'en'
const t = createTranslator(lang)

const cookieToken = Astro.cookies.get('carepro_token')?.value
if (!cookieToken) {
  return Astro.redirect('/login')
}

let caseData: any = null
let patientData: any = null
let doseLogs: any[] = []
let symptoms: any[] = []
let medications: any[] = []
let recommendations: any[] = []

try {
  caseData = await apiFetch<any>(`/cases/${caseId}`, { token: cookieToken })
  if (caseData?.patient_id) {
    const [pRes, dRes, sRes, mRes, rRes] = await Promise.all([
      apiFetch<any>(`/patients/${caseData.patient_id}`, { token: cookieToken }).catch(() => null),
      apiFetch<any[]>(`/adherence/patients/${caseData.patient_id}`, { token: cookieToken }).catch(() => []),
      apiFetch<any[]>(`/symptoms/patients/${caseData.patient_id}/symptoms`, { token: cookieToken }).catch(() => []),
      apiFetch<any[]>(`/cases/${caseId}/medications`, { token: cookieToken }).catch(() => []),
      apiFetch<any[]>(`/cases/${caseId}/recommendations`, { token: cookieToken }).catch(() => []),
    ])
    patientData = pRes
    doseLogs = dRes || []
    symptoms = sRes || []
    medications = mRes || []
    recommendations = rRes || []
  }
} catch {
  caseData = null
  patientData = null
  doseLogs = []
  symptoms = []
  medications = []
  recommendations = []
}

const patientName = patientData?.full_name || (caseData ? t('common.loading', 'Assigned Patient') : t('caseDetail.notFound', 'Case Not Found'))
const surgeryType = caseData?.surgery_type || 'N/A'
const dob = patientData?.date_of_birth || 'N/A'
const status = caseData ? (caseData.status || 'ACTIVE').toUpperCase() : 'NOT FOUND'
const emergencyName = caseData?.emergency_contact_name || 'Care Team'
const emergencyPhone = caseData?.emergency_contact_phone || 'N/A'

const completedLogs = doseLogs.filter(l => ['taken', 'missed', 'skipped'].includes(l.status?.toLowerCase()))
const takenCount = doseLogs.filter(l => l.status?.toLowerCase() === 'taken').length
const missedCount = doseLogs.filter(l => ['missed', 'skipped'].includes(l.status?.toLowerCase())).length
const adherenceRate = completedLogs.length > 0 ? Math.round((takenCount / completedLogs.length) * 100) : 100

// Triage calculation
const latestSymptom = symptoms.length > 0
  ? symptoms.sort((a, b) => new Date(b.created_at || '').getTime() - new Date(a.created_at || '').getTime())[0]
  : null

let triagePriority: 'red' | 'amber' | 'green' = 'green'
const triageReasons: string[] = []

const feeling = latestSymptom?.feeling?.toLowerCase() || ''
if (feeling === 'bad' || feeling === 'severe') {
  triagePriority = 'red'
  triageReasons.push('Acute post-op symptom or "Bad" recovery feeling reported')
} else if (feeling === 'not_great') {
  triagePriority = 'amber'
  triageReasons.push('Patient reported feeling "Not Great" on latest daily check-in')
}

if (missedCount >= 2 || adherenceRate < 60) {
  triagePriority = 'red'
  triageReasons.push(`${missedCount} medication doses missed (${adherenceRate}% adherence)`)
} else if (missedCount === 1 || adherenceRate < 80) {
  if (triagePriority !== 'red') triagePriority = 'amber'
  triageReasons.push(`1 medication dose missed (${adherenceRate}% adherence)`)
}

function calculatePostOpDay(surgeryDateStr?: string | null): string {
  if (!surgeryDateStr) return 'Day 1 Post-Op'
  try {
    const surgeryDate = new Date(surgeryDateStr)
    if (isNaN(surgeryDate.getTime())) return 'Day 1 Post-Op'
    const now = new Date()
    const diffTime = Math.abs(now.getTime() - surgeryDate.getTime())
    const diffDays = Math.max(1, Math.ceil(diffTime / (1000 * 60 * 60 * 24)))
    return `Day ${diffDays} Post-Op`
  } catch {
    return 'Day 1 Post-Op'
  }
}
const postOpDay = calculatePostOpDay(caseData?.surgery_date)
---

<AppLayout title={`${patientName} — ${surgeryType} Case Details`}>
  <div class="case-detail-page">
    <div class="top-nav-bar">
      <a href="/patients" class="back-link">
        <ArrowLeft size={16} aria-hidden="true" />
        <span>{t('caseDetail.backToPatients', 'Back to Patients Roster')}</span>
      </a>
      <div class="triage-status-pill" data-priority={triagePriority}>
        <span class="pulse-dot"></span>
        <span>
          {triagePriority === 'red' ? 'CRITICAL ATTENTION REQUIRED' : triagePriority === 'amber' ? 'CLINICAL REVIEW RECOMMENDED' : 'RECOVERY ON TRACK (STABLE)'}
        </span>
      </div>
    </div>

    <!-- Triage Warning Banner if RED or AMBER -->
    {triageReasons.length > 0 && (
      <div class={`triage-banner ${triagePriority}`}>
        <AlertTriangle size={20} class="banner-icon" />
        <div>
          <h4 class="banner-title">
            {triagePriority === 'red' ? 'High Priority Recovery Exception' : 'Moderate Clinical Exception'}
          </h4>
          <ul class="banner-list">
            {triageReasons.map((r) => <li>{r}</li>)}
          </ul>
        </div>
      </div>
    )}

    <!-- Header Card -->
    <div class="header-card">
      <div>
        <div class="patient-title-wrap">
          <h1 class="patient-name" id="case-patient-name">{patientName}</h1>
          <span class="postop-badge">{postOpDay}</span>
          <span class="status-pill open">{status}</span>
        </div>
        <p class="patient-sub" id="case-surgery-sub">
          <strong>Procedure:</strong> {surgeryType} • <strong>Surgery Date:</strong> {caseData?.surgery_date || 'N/A'} • <strong>DOB:</strong> {dob}
        </p>
      </div>

      <div class="emergency-box">
        <p class="emergency-label">{t('caseDetail.emergencyContact', 'Emergency Clinical Contact')}</p>
        <p class="emergency-name" id="emergency-name">{emergencyName}</p>
        {emergencyPhone !== 'N/A' ? (
          <a href={`tel:${emergencyPhone}`} class="tel-link" id="emergency-tel" aria-label={`Call emergency contact at ${emergencyPhone}`}>
            <Phone size={14} aria-hidden="true" />
            <span>{emergencyPhone}</span>
          </a>
        ) : (
          <span class="tel-link">{emergencyPhone}</span>
        )}
      </div>
    </div>

    <!-- Key Metrics 3-Grid -->
    <div class="metrics-grid">
      <div class="metric-card">
        <div class="metric-icon-box bg-blue">
          <Pill size={22} class="text-blue" />
        </div>
        <div class="metric-body">
          <span class="metric-label">Adherence Rate</span>
          <div class="metric-val-row">
            <span class="metric-value">{adherenceRate}%</span>
            <span class={`status-tag ${adherenceRate >= 80 ? 'good' : 'bad'}`}>
              {takenCount}/{completedLogs.length} Doses Logged
            </span>
          </div>
          <div class="progress-track">
            <div class={`progress-fill ${adherenceRate >= 80 ? 'success' : adherenceRate >= 50 ? 'warning' : 'danger'}`} style={`width: ${adherenceRate}%;`}></div>
          </div>
        </div>
      </div>

      <div class="metric-card">
        <div class="metric-icon-box bg-emerald">
          <HeartPulse size={22} class="text-emerald" />
        </div>
        <div class="metric-body">
          <span class="metric-label">Latest Check-In Feeling</span>
          <div class="metric-val-row">
            <span class="metric-value capitalize">
              {latestSymptom?.feeling ? latestSymptom.feeling.replace('_', ' ') : 'Pending'}
            </span>
            <span class={`status-tag ${feeling === 'bad' ? 'bad' : feeling === 'not_great' ? 'warning' : 'good'}`}>
              {latestSymptom?.checkin_date || 'Today'}
            </span>
          </div>
          <p class="metric-subtext">Total Check-Ins: {symptoms.length}</p>
        </div>
      </div>

      <div class="metric-card">
        <div class="metric-icon-box bg-purple">
          <Activity size={22} class="text-purple" />
        </div>
        <div class="metric-body">
          <span class="metric-label">Active Prescriptions</span>
          <div class="metric-val-row">
            <span class="metric-value">{medications.length}</span>
            <span class="status-tag info">openFDA Cross-Checked</span>
          </div>
          <p class="metric-subtext">{recommendations.length} Active Care Protocols</p>
        </div>
      </div>
    </div>

    <!-- Quick Management Action Cards -->
    <div class="nav-cards-grid">
      <a href={`/cases/${caseId}/medications`} class="nav-action-card">
        <div class="nav-card-icon">
          <Pill size={22} aria-hidden="true" />
        </div>
        <div class="nav-card-content">
          <div class="card-heading-row">
            <h3 class="nav-card-title">{t('caseDetail.prescriptions', 'Medications Regimen')}</h3>
            <span class="badge-count">{medications.length} Prescribed</span>
          </div>
          <p class="nav-card-sub">{t('caseDetail.manageMedications', 'Prescribe opioids, NSAIDs, antibiotics & openFDA cross-checks')} &rarr;</p>
        </div>
      </a>

      <a href={`/cases/${caseId}/recommendations`} class="nav-action-card">
        <div class="nav-card-icon">
          <Activity size={22} aria-hidden="true" />
        </div>
        <div class="nav-card-content">
          <div class="card-heading-row">
            <h3 class="nav-card-title">{t('caseDetail.recoveryInstructions', 'Recovery Guidelines & Protocols')}</h3>
            <span class="badge-count">{recommendations.length} Guidelines</span>
          </div>
          <p class="nav-card-sub">{t('caseDetail.manageRecommendations', 'Evidence-based recovery guidelines, wound care, and PT instructions')} &rarr;</p>
        </div>
      </a>
    </div>

    <!-- Active Prescriptions Preview Section -->
    <section class="section">
      <div class="section-header-row">
        <div class="section-title-group">
          <Pill size={18} class="sec-icon text-blue" />
          <h2 class="section-title">Active Medication Regimen ({medications.length})</h2>
        </div>
        <a href={`/cases/${caseId}/medications`} class="section-action-link">
          <Plus size={14} />
          <span>Add / Edit Prescriptions</span>
        </a>
      </div>

      <div class="table-card">
        <table class="data-table">
          <thead>
            <tr>
              <th>Medication & Form</th>
              <th>Dosage</th>
              <th>Schedule / Frequency</th>
              <th>Duration</th>
              <th>Clinical Instructions</th>
            </tr>
          </thead>
          <tbody>
            {medications.length === 0 ? (
              <tr>
                <td colspan="5" class="empty-cell">
                  No medications prescribed yet. <a href={`/cases/${caseId}/medications`} class="text-link">Click here to prescribe</a>.
                </td>
              </tr>
            ) : (
              medications.map((m) => (
                <tr>
                  <td>
                    <div class="med-name-cell">
                      <strong>{m.name}</strong>
                    </div>
                  </td>
                  <td><span class="dosage-badge">{m.dose}</span></td>
                  <td>{m.schedule_text}</td>
                  <td>{m.duration}</td>
                  <td class="text-muted">{m.notes || 'Take as directed'}</td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Patient Symptoms & Daily Check-ins History -->
    <section class="section">
      <div class="section-header-row">
        <div class="section-title-group">
          <HeartPulse size={18} class="sec-icon text-emerald" />
          <h2 class="section-title">Patient Daily Check-ins & Symptoms Telemetry ({symptoms.length})</h2>
        </div>
      </div>

      <div class="table-card">
        <table class="data-table">
          <thead>
            <tr>
              <th>Date</th>
              <th>Reported Feeling</th>
              <th>Triage Risk Level</th>
              <th>Recorded Timestamp</th>
            </tr>
          </thead>
          <tbody>
            {symptoms.length === 0 ? (
              <tr>
                <td colspan="4" class="empty-cell">
                  No check-ins recorded yet. Patient logs their recovery feeling via the mobile app daily.
                </td>
              </tr>
            ) : (
              symptoms.map((s) => {
                const sFeeling = s.feeling?.toLowerCase() || 'ok'
                const isBad = sFeeling === 'bad' || sFeeling === 'severe'
                const isNotGreat = sFeeling === 'not_great'
                return (
                  <tr>
                    <td><strong>{s.checkin_date || 'Today'}</strong></td>
                    <td>
                      <span class={`feeling-tag ${isBad ? 'tag-bad' : isNotGreat ? 'tag-warn' : 'tag-good'}`}>
                        {sFeeling.replace('_', ' ').toUpperCase()}
                      </span>
                    </td>
                    <td>
                      {isBad ? (
                        <span class="triage-alert-badge red">Emergency Risk • Immediate Review</span>
                      ) : isNotGreat ? (
                        <span class="triage-alert-badge amber">Mild Discomfort • Monitor</span>
                      ) : (
                        <span class="triage-alert-badge green">Stable Recovery</span>
                      )}
                    </td>
                    <td class="text-muted">{s.created_at ? new Date(s.created_at).toLocaleString() : '—'}</td>
                  </tr>
                )
              })
            )}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Adherence Timeline Section -->
    <section class="section">
      <div class="section-header-row">
        <div class="section-title-group">
          <Clock size={18} class="sec-icon text-purple" />
          <h2 class="section-title">{t('caseDetail.adherenceTimeline', 'Medication Adherence Dose Logs')} ({doseLogs.length})</h2>
        </div>
        <span class="adherence-badge">{t('triage.adherenceLabel', 'Adherence Rate')}: <strong>{adherenceRate}%</strong></span>
      </div>

      <div class="table-card">
        <table class="data-table">
          <thead>
            <tr>
              <th>{t('caseDetail.colMedication', 'Medication')}</th>
              <th>{t('caseDetail.colScheduled', 'Scheduled Time')}</th>
              <th>{t('caseDetail.colStatus', 'Status')}</th>
              <th>{t('caseDetail.colLogged', 'Logged At')}</th>
            </tr>
          </thead>
          <tbody>
            {doseLogs.length === 0 ? (
              <tr>
                <td colspan="4" class="empty-cell">
                  {t('caseDetail.noDoseLogs', 'No dose logs recorded yet.')}
                </td>
              </tr>
            ) : (
              doseLogs.map((log) => {
                const statusStr = log.status?.toLowerCase() || 'pending'
                const isTaken = statusStr === 'taken'
                const isMissed = statusStr === 'missed' || statusStr === 'skipped'
                return (
                  <tr>
                    <td><strong>{log.medication_name || 'Prescription Dose'}</strong></td>
                    <td>{log.scheduled_time ? new Date(log.scheduled_time).toLocaleString() : 'Scheduled Slot'}</td>
                    <td>
                      <span class={`log-badge ${isTaken ? 'badge-taken' : isMissed ? 'badge-missed' : 'badge-pending'}`}>
                        {statusStr.toUpperCase()}
                      </span>
                    </td>
                    <td class="text-muted">{log.logged_at ? new Date(log.logged_at).toLocaleString() : '—'}</td>
                  </tr>
                )
              })
            )}
          </tbody>
        </table>
      </div>
    </section>
  </div>
</AppLayout>

<style>
  .case-detail-page {
    padding: 32px;
    max-width: 1200px;
    margin: 0 auto;
  }
  .top-nav-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    font-weight: 600;
    color: #64748b;
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .back-link:hover {
    color: #0f172a;
  }
  .triage-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 700;
    padding: 6px 14px;
    border-radius: 9999px;
    letter-spacing: 0.03em;
  }
  .triage-status-pill[data-priority="red"] {
    background: #fef2f2;
    color: #b91c1c;
    border: 1px solid #fecaca;
  }
  .triage-status-pill[data-priority="amber"] {
    background: #fffbeb;
    color: #b45309;
    border: 1px solid #fde68a;
  }
  .triage-status-pill[data-priority="green"] {
    background: #f0fdf4;
    color: #15803d;
    border: 1px solid #86efac;
  }
  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: currentColor;
  }

  .triage-banner {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 16px 20px;
    border-radius: 12px;
    margin-bottom: 24px;
  }
  .triage-banner.red {
    background: #fef2f2;
    border: 1.5px solid #f87171;
    color: #991b1b;
  }
  .triage-banner.amber {
    background: #fffbeb;
    border: 1.5px solid #fcd34d;
    color: #92400e;
  }
  .banner-icon {
    flex-shrink: 0;
    margin-top: 2px;
  }
  .banner-title {
    font-size: 15px;
    font-weight: 700;
    margin: 0 0 4px 0;
  }
  .banner-list {
    margin: 0;
    padding-left: 18px;
    font-size: 13px;
  }

  .header-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 24px;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
    margin-bottom: 24px;
    gap: 24px;
  }
  .patient-title-wrap {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 8px;
  }
  .patient-name {
    font-size: 24px;
    font-weight: 700;
    color: #0f172a;
    margin: 0;
  }
  .postop-badge {
    background: #e0f2fe;
    color: #0369a1;
    font-size: 12px;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 6px;
  }
  .status-pill {
    font-size: 11px;
    font-weight: 700;
    padding: 3px 9px;
    border-radius: 9999px;
    background: #f0fdf4;
    color: #15803d;
    border: 1px solid #86efac;
  }
  .patient-sub {
    font-size: 14px;
    color: #64748b;
    margin: 0;
  }
  .emergency-box {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 14px 18px;
    min-width: 240px;
  }
  .emergency-label {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    color: #64748b;
    margin: 0 0 4px 0;
    letter-spacing: 0.03em;
  }
  .emergency-name {
    font-size: 14px;
    font-weight: 600;
    color: #0f172a;
    margin: 0 0 6px 0;
  }
  .tel-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 600;
    color: #0284c7;
    text-decoration: none;
  }
  .tel-link:hover {
    text-decoration: underline;
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 16px;
    margin-bottom: 24px;
  }
  .metric-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 18px 20px;
    display: flex;
    align-items: flex-start;
    gap: 16px;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
  }
  .metric-icon-box {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .bg-blue { background: #e0f2fe; }
  .text-blue { color: #0284c7; }
  .bg-emerald { background: #dcfce7; }
  .text-emerald { color: #059669; }
  .bg-purple { background: #f3e8ff; }
  .text-purple { color: #7c3aed; }
  .metric-body {
    flex: 1;
  }
  .metric-label {
    font-size: 12px;
    font-weight: 600;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    display: block;
    margin-bottom: 4px;
  }
  .metric-val-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 6px;
  }
  .metric-value {
    font-size: 22px;
    font-weight: 700;
    color: #0f172a;
  }
  .capitalize { text-transform: capitalize; }
  .status-tag {
    font-size: 11px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 6px;
  }
  .status-tag.good { background: #dcfce7; color: #166534; }
  .status-tag.warning { background: #fef3c7; color: #92400e; }
  .status-tag.bad { background: #fee2e2; color: #991b1b; }
  .status-tag.info { background: #e0e7ff; color: #3730a3; }
  .metric-subtext {
    font-size: 12px;
    color: #64748b;
    margin: 0;
  }
  .progress-track {
    height: 6px;
    background: #e2e8f0;
    border-radius: 9999px;
    overflow: hidden;
    margin-top: 6px;
  }
  .progress-fill {
    height: 100%;
    border-radius: 9999px;
    transition: width 0.3s ease;
  }
  .progress-fill.success { background: #22c55e; }
  .progress-fill.warning { background: #f59e0b; }
  .progress-fill.danger { background: #ef4444; }

  .nav-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 16px;
    margin-bottom: 32px;
  }
  .nav-action-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 20px;
    display: flex;
    align-items: center;
    gap: 16px;
    text-decoration: none;
    transition: all 0.15s ease;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
  }
  .nav-action-card:hover {
    border-color: #0284c7;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(2, 132, 199, 0.08);
  }
  .nav-card-icon {
    width: 48px;
    height: 48px;
    background: #f0f9ff;
    color: #0284c7;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
