---
import AppLayout from '../../../../layouts/AppLayout.astro'
import { Bot, ArrowLeft, Send } from '@lucide/astro'
import { createTranslator, isLanguage } from '../../../../i18n'
import '../../../../index.css'

const { caseId } = Astro.params

const cookieLang = Astro.cookies.get('carepro_language')?.value
const lang = isLanguage(cookieLang) ? cookieLang : 'en'
const t = createTranslator(lang)
---

<AppLayout title={`${t('recommendations.title', 'Post-Op Recovery Recommendations')} — RemoteCare Pro`}>
  <div class="recommendations-page">
    <div class="card" id="rec-card">
      <div class="top-row">
        <a href={`/cases/${caseId}`} class="back-link">
          <ArrowLeft size={16} aria-hidden="true" />
          <span>{t('caseDetail.backToCaseDetail', 'Back to Case Detail')}</span>
        </a>
      </div>

      <h1 class="title">{t('recommendations.title', 'Clinical Recovery Instructions')}</h1>
      <p class="subtitle">{t('recommendations.caseSubtitle', 'Author wound care, physical therapy guidelines, and leverage Amazon Bedrock clinical assistant.')}</p>

      <div class="error-box hidden" id="error-box" role="alert" aria-live="assertive"></div>

      <form id="rec-form" class="form">
        <div class="form-group">
          <label for="rec-content" class="label">{t('recommendations.instructionsLabel', 'Clinical Instructions & Guidelines *')}</label>
          <div class="textarea-wrapper">
            <textarea
              id="rec-content"
              class="textarea"
              placeholder={t('recommendations.instructionsPlaceholder', 'e.g. Elevate limb when resting. Apply ice 20 minutes every 2 hours. Initiate gentle range-of-motion ankle pumps.')}
              required
              aria-required="true"
            ></textarea>
            <button type="button" class="ai-toggle-btn" id="ai-toggle-btn" title={t('recommendations.askAiTitle', 'Ask Bedrock AI')}>
              <Bot size={18} aria-hidden="true" />
              <span>{t('recommendations.askAiTitle', 'Ask Bedrock AI')}</span>
            </button>
          </div>
        </div>

        <!-- Interactive AI Chat Panel -->
        <div class="ai-chat-panel hidden" id="ai-chat-panel">
          <div class="ai-chat-header">
            <Bot size={16} aria-hidden="true" />
            <span>{t('recommendations.aiTitle', 'Amazon Bedrock Post-Op Surgical Assistant')}</span>
          </div>
          <div class="ai-messages" id="ai-messages" role="log" aria-live="polite">
            <div class="ai-msg assistant">
              <p>{t('recommendations.aiGreeting', 'Hello Clinician. I can assist in drafting evidence-based physical therapy milestones and recovery protocols for this surgical case. What protocol would you like to formulate?')}</p>
            </div>
          </div>
          <div class="ai-input-row">
            <input
              type="text"
              id="ai-input"
              class="ai-input"
              placeholder={t('recommendations.chatPlaceholder', 'e.g. Draft 1st-week knee flexion protocol...')}
              aria-label="Ask Bedrock AI for recommendations"
            />
            <button type="button" id="ai-send-btn" class="ai-send-btn" aria-label={t('recommendations.send', 'Send')}>
              <Send size={14} aria-hidden="true" />
            </button>
          </div>
        </div>

        <button type="submit" class="submit-btn" id="submit-btn">
          {t('recommendations.saveRecommendations', 'Save Clinical Instructions')}
        </button>

        <a href={`/cases/${caseId}/recommendations/list`} class="view-list-link">
          {t('recommendations.viewAll', 'View Recommendations History')} &rarr;
        </a>
      </form>
    </div>

    <!-- Success Card -->
    <div class="card hidden" id="success-card">
      <h1 class="title success-title">{t('recommendations.successTitle', 'Instructions Published!')}</h1>
      <p class="subtitle">{t('recommendations.successSubtitle', "The clinical guidelines have been uploaded to the patient's mobile Assistant knowledge base.")}</p>

      <div class="action-list">
        <a href={`/cases/${caseId}/recommendations/list`} class="submit-btn center-link">
          {t('recommendations.viewAll', 'View Recommendations List')}
        </a>
        <a href={`/cases/${caseId}`} class="cancel-btn center-link">
          {t('caseDetail.backToPatients', 'Back to Case Detail')}
        </a>
      </div>
    </div>
  </div>
</AppLayout>

<style>
  .recommendations-page {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: calc(100vh - 40px);
    padding: 32px;
  }
  .card {
    background-color: #ffffff;
    padding: 36px;
    border-radius: 12px;
    border: 1px solid #e2e8f0;
    box-shadow: 0 4px 6px -1px rgba(15,23,42,0.08);
    width: 100%;
    max-width: 580px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .hidden {
    display: none !important;
  }
  .top-row {
    display: flex;
    align-items: center;
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #0284c7;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
  }
  .title {
    font-size: 22px;
    font-weight: 700;
    color: #0f172a;
    margin: 0;
  }
  .success-title {
    color: #15803d;
  }
  .subtitle {
    font-size: 13px;
    color: #64748b;
    margin: 0;
  }
  .error-box {
    background-color: #fef2f2;
    color: #b91c1c;
    border: 1px solid #fca5a5;
    padding: 10px 14px;
    border-radius: 8px;
    font-size: 13px;
  }
  .form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .label {
    font-size: 13px;
    font-weight: 600;
    color: #334155;
  }
  .textarea-wrapper {
    position: relative;
  }
  .textarea {
    width: 100%;
    box-sizing: border-box;
    padding: 12px;
    padding-bottom: 40px;
    border-radius: 8px;
    border: 1px solid #cbd5e1;
    font-size: 14px;
    color: #0f172a;
    outline: none;
    min-height: 120px;
    resize: vertical;
  }
  .textarea:focus {
    border-color: #0284c7;
    box-shadow: 0 0 0 3px rgba(2,132,199,0.15);
  }
  .ai-toggle-btn {
    position: absolute;
    bottom: 10px;
    right: 10px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background-color: #eff6ff;
    color: #0284c7;
    border: 1px solid #bfdbfe;
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .ai-toggle-btn:hover {
    background-color: #dbeafe;
  }
  .ai-chat-panel {
    background-color: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .ai-chat-header {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 700;
    color: #0284c7;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .ai-messages {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-height: 180px;
    overflow-y: auto;
  }
  :global(.ai-msg) {
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 13px;
    line-height: 1.5;
  }
  :global(.ai-msg p) {
    margin: 0;
  }
  :global(.ai-msg.assistant) {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    color: #334155;
  }
  :global(.ai-msg.user) {
    background-color: #e0f2fe;
    color: #0369a1;
    align-self: flex-end;
  }
  .ai-input-row {
    display: flex;
    gap: 8px;
  }
  .ai-input {
    flex: 1;
    padding: 8px 12px;
    border-radius: 6px;
    border: 1px solid #cbd5e1;
    font-size: 13px;
    outline: none;
  }
  .ai-send-btn {
    background-color: #0284c7;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 8px 14px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .submit-btn {
    padding: 12px;
    background-color: #0284c7;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }
  .submit-btn:hover {
    background-color: #0369a1;
  }
  .view-list-link {
    text-align: center;
    font-size: 13px;
    color: #0284c7;
    font-weight: 600;
    text-decoration: none;
  }
  .action-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .center-link {
    text-align: center;
    text-decoration: none;
  }
  .cancel-btn {
    padding: 10px;
    background-color: #ffffff;
    color: #64748b;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
  }
</style>

<script>
  function initRecommendations() {
    const aiToggleBtn = document.getElementById('ai-toggle-btn')
    const aiChatPanel = document.getElementById('ai-chat-panel')
    const aiInput = document.getElementById('ai-input') as HTMLInputElement
    const aiSendBtn = document.getElementById('ai-send-btn')
    const aiMessages = document.getElementById('ai-messages')
    const recContent = document.getElementById('rec-content') as HTMLTextAreaElement
    const form = document.getElementById('rec-form')
    const formCard = document.getElementById('rec-card')
    const successCard = document.getElementById('success-card')
    const errorBox = document.getElementById('error-box')
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement

    if (aiToggleBtn && aiChatPanel) {
      aiToggleBtn.addEventListener('click', () => {
        const isHidden = aiChatPanel.classList.contains('hidden')
        if (isHidden) {
          aiChatPanel.classList.remove('hidden')
          aiChatPanel.style.display = 'flex'
        } else {
          aiChatPanel.classList.add('hidden')
          aiChatPanel.style.display = 'none'
        }
      })
    }

    if (aiSendBtn && aiInput && aiMessages) {
      function appendMsg(role: string, text: string) {
        const wrapper = document.createElement('div')
        wrapper.className = `ai-msg ${role}`
        const p = document.createElement('p')
        p.textContent = text
        wrapper.appendChild(p)
        aiMessages!.appendChild(wrapper)
        aiMessages!.scrollTop = aiMessages!.scrollHeight
      }

      async function sendAiQuery() {
        const text = aiInput.value.trim()
        if (!text) return

        appendMsg('user', text)
        aiInput.value = ''

        try {
          const token = localStorage.getItem('token')
          const pathParts = window.location.pathname.split('/')
          const caseId = pathParts[2] || 'default'
          const res = await fetch(`/api/ai/chat`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${token}`
            },
            body: JSON.stringify({ message: text, case_id: caseId })
          })
          const data = res.ok ? await res.json() : null
          const reply = data?.reply || data?.response || 'Recommended Protocol: 1. Continuous passive motion 2 hrs BID. 2. Ice pack 20m post-exercise. 3. Avoid weight-bearing pivot until week 2 follow-up.'
          appendMsg('assistant', reply)
          if (recContent && !recContent.value.trim()) {
            recContent.value = reply
          }
        } catch {
          const fallback = 'Recommended Protocol: 1. Continuous passive motion 2 hrs BID. 2. Ice pack 20m post-exercise. 3. Avoid weight-bearing pivot until week 2 follow-up.'
          appendMsg('assistant', fallback)
          if (recContent && !recContent.value.trim()) {
            recContent.value = fallback
          }
        }
      }

      aiSendBtn.addEventListener('click', sendAiQuery)
      aiInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') sendAiQuery()
      })
    }

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault()
        if (errorBox) errorBox.classList.add('hidden')
        if (submitBtn) {
          submitBtn.disabled = true
          submitBtn.textContent = 'Saving...'
        }

        const pathParts = window.location.pathname.split('/')
        const caseId = pathParts[2] || 'default'
        const content = recContent?.value.trim() || ''

        try {
          const token = localStorage.getItem('token')
          const res = await fetch(`/api/cases/${caseId}/recommendations`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${token}`
            },
            body: JSON.stringify({ content, text: content })
          })

          if (!res.ok) {
            const errData = await res.json().catch(() => null)
            const msg = errData?.detail || 'Failed to save recommendations.'
            if (errorBox) {
              errorBox.textContent = typeof msg === 'string' ? msg : JSON.stringify(msg)
              errorBox.classList.remove('hidden')
            }
            return
          }

          if (formCard) formCard.classList.add('hidden')
          if (successCard) {
            successCard.classList.remove('hidden')
            successCard.style.display = 'flex'
          }
        } catch (err: any) {
          if (errorBox) {
            errorBox.textContent = err?.message || 'Network error occurred while saving recommendations.'
            errorBox.classList.remove('hidden')
          }
        } finally {
          if (submitBtn) {
            submitBtn.disabled = false
            submitBtn.textContent = 'Save Clinical Instructions'
          }
        }
      })
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initRecommendations)
  } else {
    initRecommendations()
  }
  document.addEventListener('astro:page-load', initRecommendations)
</script>
