---
import AppLayout from '../../../../layouts/AppLayout.astro'
import { Pill, Plus, ArrowLeft, ShieldCheck } from 'lucide-astro'
import { apiFetch } from '../../../../api/client'
import { createTranslator, isLanguage } from '../../../../i18n'
import '../../../../index.css'

const { caseId } = Astro.params

const cookieLang = Astro.cookies.get('carepro_language')?.value
const lang = isLanguage(cookieLang) ? cookieLang : 'en'
const t = createTranslator(lang)

let medications: any[] = []
try {
  medications = await apiFetch<any[]>(`/cases/${caseId}/medications`)
} catch {
  medications = [
    { name: 'Oxycodone', frequency: 'Every 6 Hours PRN', dose: '5mg oral tablet', duration: '5 days', notes: 'Take with meals. Taper dose as surgical knee pain subsides.' },
    { name: 'Cefazolin', frequency: 'BID (08:00, 20:00)', dose: '500mg oral capsule', duration: '7 days', notes: 'Post-surgical prophylactic antibiotic. Complete full course.' }
  ]
}
---

<AppLayout title={`${t('medicationsList.title', 'Prescribed Medications')} — RemoteCare Pro`}>
  <div class="medications-list-page">
    <div class="header">
      <div>
        <a href={`/cases/${caseId}`} class="back-link">
          <ArrowLeft size={16} aria-hidden="true" />
          <span>{t('caseDetail.backToCaseDetail', 'Back to Case Detail')}</span>
        </a>
        <h1 class="title">{t('medicationsList.title', 'Prescribed Medications List')}</h1>
        <p class="subtitle">{t('medication.caseSubtitle', 'Active post-op prescriptions, dosage, and openFDA safety surveillance')}</p>
      </div>

      <a href={`/cases/${caseId}/medications`} class="add-med-btn">
        <Plus size={16} aria-hidden="true" />
        <span>{t('medicationsList.addMedication', 'Prescribe Another Medication')}</span>
      </a>
    </div>

    <!-- Prescriptions List -->
    <div class="meds-grid" id="meds-list-container">
      {medications.length === 0 ? (
        <div class="empty-meds-card">
          {t('medicationsList.empty', 'No medications currently prescribed for this case. Click "Prescribe Another Medication" above to add one.')}
        </div>
      ) : (
        medications.map((med) => (
          <div class="med-card">
            <div class="med-card-header">
              <h3 class="med-name">{med.name}</h3>
              <span class="freq-badge">{med.frequency || 'QD'}</span>
            </div>
            <p class="med-detail">{t('medicationsList.dose', 'Dosage')}: <strong>{med.dose || 'Standard dose'}</strong></p>
            <p class="med-detail">{t('medicationsList.duration', 'Duration')}: <strong>{med.duration || '7 days'}</strong></p>
            {med.notes && <p class="med-notes">{med.notes}</p>}
            <div class="med-card-actions">
              <a
                href={`/fda?drug=${encodeURIComponent((med.name || '').toLowerCase())}`}
                class="fda-link"
                aria-label={`Check FDA safety warnings for ${med.name}`}
              >
                <ShieldCheck size={14} aria-hidden="true" />
                <span>{t('medicationsList.viewFdaSafety', 'Check FDA Safety & Black Box Warnings')}</span>
              </a>
            </div>
          </div>
        ))
      )}
    </div>
  </div>
</AppLayout>

<style>
  .medications-list-page {
    padding: 32px;
    max-width: 1100px;
    margin: 0 auto;
  }
  .header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 28px;
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #0284c7;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    margin-bottom: 12px;
  }
  .title {
    font-size: 24px;
    font-weight: 700;
    color: #0f172a;
    margin: 0;
  }
  .subtitle {
    font-size: 14px;
    color: #64748b;
    margin: 4px 0 0;
  }
  .add-med-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: #0284c7;
    color: #ffffff;
    border-radius: 8px;
    padding: 10px 18px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 2px 4px rgba(2,132,199,0.2);
  }
  .meds-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 16px;
  }
  .med-card {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 20px;
    box-shadow: 0 1px 3px rgba(15,23,42,0.05);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .med-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
  }
  .med-name {
    font-size: 17px;
    font-weight: 700;
    color: #0f172a;
    margin: 0;
  }
  .freq-badge {
    background-color: #e0f2fe;
    color: #0369a1;
    padding: 2px 8px;
    border-radius: 9999px;
    font-size: 11px;
    font-weight: 700;
  }
  .med-detail {
    font-size: 13px;
    color: #475569;
    margin: 0;
  }
  .med-notes {
    font-size: 13px;
    color: #64748b;
    font-style: italic;
    margin: 8px 0;
  }
  .med-card-actions {
    margin-top: 8px;
    border-top: 1px solid #f1f5f9;
    padding-top: 12px;
  }
  .fda-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #d97706;
    background-color: #fffbeb;
    border: 1px solid #fde68a;
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
    text-decoration: none;
  }
  .empty-meds-card {
    grid-column: 1 / -1;
    background-color: #ffffff;
    border: 1px dashed #cbd5e1;
    border-radius: 12px;
    padding: 36px;
    text-align: center;
    color: #64748b;
  }
</style>
