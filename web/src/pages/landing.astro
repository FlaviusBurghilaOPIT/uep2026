<script>
  function initLandingPage() {
    // Launch Demo Buttons
    const demoBtns = document.querySelectorAll('.launch-demo-btn')
    demoBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        window.location.href = '/login?demo=true'
      })
    })

    // Simulate Outreach Interaction
    const simulateBtn = document.getElementById('simulate-outreach-btn')
    const simulateBtnText = document.getElementById('simulate-btn-text')
    const demoBadge = document.getElementById('demo-badge')
    const badgeText = document.getElementById('badge-text')
    const badgeIconAlert = document.getElementById('badge-icon-alert')
    const badgeIconResolved = document.getElementById('badge-icon-resolved')
    const telemetryStatus = document.getElementById('telemetry-status')
    const resolvedBanner = document.getElementById('resolved-banner')

    if (simulateBtn) {
      simulateBtn.addEventListener('click', () => {
        if (simulateBtnText) simulateBtnText.textContent = 'Initiating Clinical Outreach...'
        setTimeout(() => {
          if (simulateBtn) simulateBtn.style.display = 'none'
          if (resolvedBanner) resolvedBanner.style.display = 'flex'
          if (demoBadge) {
            demoBadge.classList.add('resolved')
          }
          if (badgeIconAlert) badgeIconAlert.style.display = 'none'
          if (badgeIconResolved) badgeIconResolved.style.display = 'inline-block'
          if (badgeText) badgeText.textContent = 'RESOLVED • Outreach Logged'
          if (telemetryStatus) {
            telemetryStatus.classList.add('good')
            telemetryStatus.textContent = 'Patient Contacted • Regimen Adjusted'
          }
        }, 500)
      })
    }
  }

  initLandingPage()
  document.addEventListener('astro:page-load', initLandingPage)
</script>
