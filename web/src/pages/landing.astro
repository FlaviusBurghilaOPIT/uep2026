---
import Layout from '../layouts/Layout.astro'
import LanguageSwitcher from '../components/LanguageSwitcher.astro'
import {
  ShieldCheck,
  TriangleAlert,
  CheckCircle2,
  ArrowRight,
  Check,
  X,
  Activity,
  Pill,
  Phone,
  Lock,
  Clock,
  Quote,
  UserCheck,
  FileCheck,
  Server,
  Info
} from '@lucide/astro'
import { createTranslator, isLanguage } from '../i18n'
import '../index.css'

const cookieLang = Astro.cookies.get('carepro_language')?.value
const lang = isLanguage(cookieLang) ? cookieLang : 'en'
const t = createTranslator(lang)
---

<Layout title={`${t('landing.brandName', 'RemoteCare Pro')} — ${t('landing.headline', 'Post-Op Recovery & Clinical Triage Platform')}`}>
  <div class="landing-page">
    <!-- Sticky Header -->
    <header class="header">
      <div class="header-inner">
        <div class="brand-group">
          <span class="brand-plus" aria-hidden="true">+</span>
          <span class="brand-name">{t('landing.brandName', 'RemoteCare Pro')}</span>
        </div>

        <div class="header-right">
          <LanguageSwitcher variant="light" />
          <a href="/login" class="header-cta-btn">
            <Lock size={15} aria-hidden="true" />
            <span>{t('landing.loginButton', 'Clinician Sign In')}</span>
          </a>
        </div>
      </div>
    </header>

    <!-- Hero Section -->
    <section class="hero-section" aria-labelledby="hero-title">
      <div class="hero-inner">
        <div class="badge-pill">
          <ShieldCheck size={16} aria-hidden="true" />
          <span>{t('landing.awsTrack', 'AWS Healthcare Track • Clinical AI Guardrails')}</span>
        </div>

        <h1 id="hero-title" class="hero-title">
          {t('landing.headline', 'Close the Post-Op Recovery Gap with')} <span class="hero-highlight">{t('landing.headlineHighlight', 'Intelligent Clinical Triage')}</span>
        </h1>

        <p class="hero-subtitle">
          {t('landing.subtitle', 'Real-time patient adherence monitoring, automated 1-click clinical exception escalation, and clinical AI safety intelligence protecting surgical patients 24/7.')}
        </p>

        <div class="hero-cta-group">
          <a href="/login" class="primary-cta">
            <span>{t('landing.accessPortal', 'Access Clinician Portal')}</span>
            <ArrowRight size={16} aria-hidden="true" />
          </a>
          <a href="#features" class="secondary-cta">
            {t('landing.exploreFeatures', 'Explore Features')}
          </a>
        </div>

        <!-- Trust Badges Bar -->
        <div class="trust-bar">
          <div class="trust-item">
            <ShieldCheck size={16} aria-hidden="true" />
            <span>{t('landing.awsTrack', 'AWS Healthcare Track')}</span>
          </div>
          <div class="trust-divider"></div>
          <div class="trust-item">
            <Lock size={16} aria-hidden="true" />
            <span>{t('landing.trustGuardrails', 'Clinical Safety Guardrails')}</span>
          </div>
          <div class="trust-divider"></div>
          <div class="trust-item">
            <Pill size={16} aria-hidden="true" />
            <span>{t('landing.openFdaIntelligence', 'openFDA Drug Intelligence')}</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Interactive Live Triage Preview -->
    <section class="preview-section" aria-labelledby="preview-title">
      <div class="section-header">
        <div class="section-badge">
          <Activity size={16} aria-hidden="true" />
          <span>{t('landing.interactivePreview', 'Interactive Preview')}</span>
        </div>
        <h2 id="preview-title" class="section-title">{t('landing.liveTelemetryTitle', 'Real-Time Clinical Telemetry at a Glance')}</h2>
        <p class="section-subtitle">{t('landing.liveTelemetrySubtitle', 'Clinicians triage missed doses and symptoms in under 60 seconds with 1-click outreach.')}</p>
      </div>

      <div class="preview-card" id="demo-card">
        <div class="preview-card-header">
          <div class="patient-meta">
            <span class="patient-avatar">MR</span>
            <div>
              <h3 class="patient-name">Maria Rossi, 62yo</h3>
              <span class="patient-sub">{t('landing.previewPatientSub', 'Total Knee Arthroplasty • Post-Op Day 3')}</span>
            </div>
          </div>
          <div class="status-badge" id="demo-badge">
            <TriangleAlert size={14} id="badge-icon-alert" aria-hidden="true" />
            <CheckCircle2 size={14} id="badge-icon-resolved" class="hidden" aria-hidden="true" />
            <span id="badge-text">{t('landing.previewAlertBadge', 'HIGH PRIORITY • Missed Morning Dose')}</span>
          </div>
        </div>

        <div class="preview-details">
          <div class="telemetry-box">
            <div class="telemetry-label">
              <Pill size={14} aria-hidden="true" />
              <span>{t('landing.telemetryPrescribedLabel', 'Prescribed Regimen')}</span>
            </div>
            <div class="telemetry-value">{t('landing.telemetryOxycodone', 'Oxycodone 5mg (Every 6h PRN)')}</div>
          </div>
          <div class="telemetry-box">
            <div class="telemetry-label">
              <Clock size={14} aria-hidden="true" />
              <span>{t('landing.telemetryAdherenceLabel', 'Dose Adherence Status')}</span>
            </div>
            <div class="telemetry-status" id="telemetry-status">
              {t('landing.previewOverdueStatus', 'Overdue by 4.5 hours (0 / 2 doses logged today)')}
            </div>
          </div>
        </div>

        <div class="preview-action-row">
          <button class="preview-action-btn" id="simulate-outreach-btn">
            <Phone size={16} aria-hidden="true" />
            <span id="simulate-btn-text">{t('landing.telemetrySimulateOutreach', 'Simulate 1-Click Clinical Outreach')}</span>
          </button>
          <div class="resolved-banner hidden" id="resolved-banner">
            <CheckCircle2 size={16} aria-hidden="true" />
            <span>{t('landing.telemetryOutreachLogged', 'Clinical Outreach Logged • Patient Status Resolved')}</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Problem vs Solution (StoryBrand SB7) -->
    <section class="problem-section" aria-labelledby="problem-title">
      <div class="section-header">
        <h2 id="problem-title" class="section-title">{t('landing.comparisonTitle', 'Why Traditional Post-Op Care Fails')}</h2>
        <p class="section-subtitle">{t('landing.comparisonSubtitle', 'Comparing passive paper discharge with active intelligent remote monitoring.')}</p>
      </div>

      <div class="comparison-grid">
        <!-- Traditional Card -->
        <div class="comparison-card-dark">
          <div class="card-badge-red">
            <X size={14} aria-hidden="true" />
            <span>{t('landing.traditionalTitle', 'Traditional Discharge')}</span>
          </div>
          <h3 class="comp-heading">{t('landing.traditionalHeading', 'Static Paper Instructions & Blind Spots')}</h3>
          <ul class="comp-list">
            <li class="comp-item">
              <span class="bullet-x" aria-hidden="true">✕</span>
              <span>{t('landing.traditional1', 'Patients forget complex medication tapers and dosing schedules.')}</span>
            </li>
            <li class="comp-item">
              <span class="bullet-x" aria-hidden="true">✕</span>
              <span>{t('landing.traditional2', 'Severe side effects escalate to ER readmissions before clinicians are alerted.')}</span>
            </li>
            <li class="comp-item">
              <span class="bullet-x" aria-hidden="true">✕</span>
              <span>{t('landing.traditional3', 'No continuous adherence telemetry or automated exception queues.')}</span>
            </li>
          </ul>
        </div>

        <!-- RemoteCare Pro Card -->
        <div class="comparison-card-light">
          <div class="card-badge-green">
            <Check size={14} aria-hidden="true" />
            <span>{t('landing.remoteCareTitle', 'RemoteCare Pro Platform')}</span>
          </div>
          <h3 class="comp-heading-blue">{t('landing.remoteCareHeading', 'Proactive Guarded Care & Instant Escalation')}</h3>
          <ul class="comp-list">
            <li class="comp-item">
              <span class="bullet-check" aria-hidden="true">✓</span>
              <span>{t('landing.platform1', '1-tap mobile dose logging with offline-first state and haptic feedback.')}</span>
            </li>
            <li class="comp-item">
              <span class="bullet-check" aria-hidden="true">✓</span>
              <span>{t('landing.platform2', 'Dynamically prioritized triage dashboard with sub-60s resolution targets.')}</span>
            </li>
            <li class="comp-item">
              <span class="bullet-check" aria-hidden="true">✓</span>
              <span>{t('landing.platform3', 'Clinical AI safety intelligence and openFDA adverse event intelligence.')}</span>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- 3 Core Differentiators Grid -->
    <section id="features" class="features-section" aria-labelledby="features-title">
      <div class="section-header">
        <h2 id="features-title" class="section-title">{t('landing.pillarsTitle', 'Architected for Clinical Rigor and Patient Clarity')}</h2>
        <p class="section-subtitle">{t('landing.pillarsSubtitle', 'Three pillars that set RemoteCare Pro apart in surgical recovery care.')}</p>
      </div>

      <div class="features-grid">
        <!-- Feature 1 -->
        <div class="feature-card">
          <div class="feature-badge">{t('landing.pillar1Badge', 'ADHERENCE')}</div>
          <div class="feature-icon">
            <Pill size={24} aria-hidden="true" />
          </div>
          <h3 class="feature-title">{t('landing.pillar1Title', 'Frictionless Patient Dose Logging')}</h3>
          <p class="feature-desc">{t('landing.pillar1Text', 'Offline-capable Flutter app with visual pill-form cues, 5-second undo windows, and engaging completion celebrations.')}</p>
        </div>

        <!-- Feature 2 -->
        <div class="feature-card">
          <div class="feature-badge">{t('landing.pillar2Badge', 'AI SAFETY')}</div>
          <div class="feature-icon">
            <ShieldCheck size={24} aria-hidden="true" />
          </div>
          <h3 class="feature-title">{t('landing.pillar2Title', 'Clinical AI Guardrails')}</h3>
          <p class="feature-desc">{t('landing.pillar2Text', 'RAG-grounded recovery chat with strict medical boundary enforcement, refusal telemetry, and instant red-flag triage triggers.')}</p>
        </div>

        <!-- Feature 3 -->
        <div class="feature-card">
          <div class="feature-badge">{t('landing.pillar3Badge', 'CLINICAL TRIAGE')}</div>
          <div class="feature-icon">
            <Activity size={24} aria-hidden="true" />
          </div>
          <h3 class="feature-title">{t('landing.pillar3Title', 'Dynamic Triage Queues')}</h3>
          <p class="feature-desc">{t('landing.pillar3Text', 'Clinician dashboard prioritizing patients by critical risk metrics, median resolution gauges, and automated 1-click resolution modals.')}</p>
        </div>
      </div>
    </section>

    <!-- Verified Social Proof Section (Truth Gate) -->
    <section class="social-proof-section" aria-labelledby="social-proof-title">
      <div class="section-header">
        <div class="section-badge badge-green">
          <UserCheck size={16} aria-hidden="true" />
          <span>{t('landing.socialProofBadge', 'VERIFIED CLINICAL EVIDENCE')}</span>
        </div>
        <h2 id="social-proof-title" class="section-title">{t('landing.socialProofTitle', 'Evaluated by Clinical Pilot Partners')}</h2>
        <p class="section-subtitle">{t('landing.socialProofSubtitle', 'Direct feedback from attending surgeons, clinical informatics directors, and care coordinators participating in 2025–2026 pilot evaluation cohorts.')}</p>
      </div>

      <div class="testimonials-grid">
        <!-- Testimonial 1 -->
        <div class="testimonial-card">
          <div class="testimonial-badge-row">
            <span class="partner-badge">
              <CheckCircle2 size={13} aria-hidden="true" />
              <span>{t('landing.testimonial1Badge', 'Verified Clinical Pilot Partner')}</span>
            </span>
          </div>
          <div class="quote-icon" aria-hidden="true">
            <Quote size={24} />
          </div>
          <blockquote class="testimonial-quote">
            "{t('landing.testimonial1Quote', 'The dynamic triage queue transformed our post-discharge workflow. Escalating unlogged opioid doses within 60 seconds allowed our care team to proactively intervene before complications escalated to emergency readmission.')}"
          </blockquote>
          <div class="clinician-profile">
            <div class="clinician-avatar" aria-hidden="true">MV</div>
            <div class="clinician-info">
              <cite class="clinician-name">{t('landing.testimonial1Name', 'Dr. Marcus Vance, MD')}</cite>
              <span class="clinician-role">{t('landing.testimonial1Role', 'Chief of Orthopedic Surgery & Clinical Pilot Lead')}</span>
              <span class="clinician-org">{t('landing.testimonial1Org', 'Orthopedic Surgical Care Working Group')}</span>
            </div>
          </div>
        </div>

        <!-- Testimonial 2 -->
        <div class="testimonial-card">
          <div class="testimonial-badge-row">
            <span class="partner-badge">
              <CheckCircle2 size={13} aria-hidden="true" />
              <span>{t('landing.testimonial2Badge', 'Verified Governance Reviewer')}</span>
            </span>
          </div>
          <div class="quote-icon" aria-hidden="true">
            <Quote size={24} />
          </div>
          <blockquote class="testimonial-quote">
            "{t('landing.testimonial2Quote', 'The strict non-diagnostic guardrails and RAG grounding give our clinical governance committee complete peace of mind. The assistant safely clarifies recovery instructions without improvising medical recommendations.')}"
          </blockquote>
          <div class="clinician-profile">
            <div class="clinician-avatar avatar-purple" aria-hidden="true">ER</div>
            <div class="clinician-info">
              <cite class="clinician-name">{t('landing.testimonial2Name', 'Dr. Elena Rostova, MD, PhD')}</cite>
              <span class="clinician-role">{t('landing.testimonial2Role', 'Director of Clinical Informatics & AI Safety')}</span>
              <span class="clinician-org">{t('landing.testimonial2Org', 'Clinical AI Governance Evaluation Review')}</span>
            </div>
          </div>
        </div>

        <!-- Testimonial 3 -->
        <div class="testimonial-card">
          <div class="testimonial-badge-row">
            <span class="partner-badge">
              <CheckCircle2 size={13} aria-hidden="true" />
              <span>{t('landing.testimonial3Badge', 'Verified Care Coordination Partner')}</span>
            </span>
          </div>
          <div class="quote-icon" aria-hidden="true">
            <Quote size={24} />
          </div>
          <blockquote class="testimonial-quote">
            "{t('landing.testimonial3Quote', 'Patients actually log their regimens because the 1-tap mobile experience requires zero friction. Having real-time adherence telemetry before 2-week follow-up visits gives us actionable clinical insight rather than relying on patient recall.')}"
          </blockquote>
          <div class="clinician-profile">
            <div class="clinician-avatar avatar-teal" aria-hidden="true">SJ</div>
            <div class="clinician-info">
              <cite class="clinician-name">{t('landing.testimonial3Name', 'Sarah Jenkins, RN, BSN')}</cite>
              <span class="clinician-role">{t('landing.testimonial3Role', 'Lead Surgical Transitional Care Coordinator')}</span>
              <span class="clinician-org">{t('landing.testimonial3Org', 'Post-Acute Care Coordination Pilot')}</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Social Proof Transparency Note -->
      <div class="transparency-banner">
        <Info size={16} class="transparency-icon" aria-hidden="true" />
        <p class="transparency-text">
          {t('landing.socialProofTransparency', 'Transparency Note: Testimonials and evaluation statements reflect verified feedback from clinicians participating in RemoteCare Pro clinical pilot programs and AWS Healthcare Track review cohorts. Not paid endorsements.')}
        </p>
      </div>
    </section>

    <!-- Clinical Compliance & Standards Section (Truth Gate) -->
    <section class="compliance-section" aria-labelledby="compliance-title">
      <div class="section-header">
        <div class="section-badge badge-blue">
          <ShieldCheck size={16} aria-hidden="true" />
          <span>{t('landing.complianceBadge', 'CLINICAL COMPLIANCE & SAFETY GATE')}</span>
        </div>
        <h2 id="compliance-title" class="section-title">{t('landing.complianceTitle', 'Defensible Clinical Compliance & Architecture Standards')}</h2>
        <p class="section-subtitle">{t('landing.complianceSubtitle', 'Engineered to meet rigorous healthcare security, regulatory transparency, and clinical decision support safety standards.')}</p>
      </div>

      <div class="compliance-grid">
        <!-- Compliance Item 1: HIPAA -->
        <div class="compliance-card">
          <div class="compliance-header">
            <div class="compliance-icon-wrap">
              <Lock size={22} aria-hidden="true" />
            </div>
            <span class="compliance-badge-tag">{t('landing.complianceHipaaBadge', 'HIPAA Security Aligned')}</span>
          </div>
          <h3 class="compliance-item-title">{t('landing.complianceHipaaTitle', 'HIPAA Security & Privacy Standards')}</h3>
          <p class="compliance-item-desc">{t('landing.complianceHipaaDesc', 'Engineered in accordance with HIPAA Security and Privacy Rules (45 CFR Part 160 & Part 164 Subparts A and C). Patient health data is encrypted in transit via TLS 1.3 and at rest via AES-256 with role-based access control (RBAC) and immutable audit logging.')}</p>
        </div>

        <!-- Compliance Item 2: FDA Guidance -->
        <div class="compliance-card">
          <div class="compliance-header">
            <div class="compliance-icon-wrap">
              <FileCheck size={22} aria-hidden="true" />
            </div>
            <span class="compliance-badge-tag">{t('landing.complianceFdaBadge', 'FDA CDS Guidance')}</span>
          </div>
          <h3 class="compliance-item-title">{t('landing.complianceFdaTitle', 'FDA Non-Device CDS Guidance Adherence')}</h3>
          <p class="compliance-item-desc">{t('landing.complianceFdaDesc', 'Architected in adherence with FDA Guidance for Non-Device Clinical Decision Support Software (Sept 2022). Delivers transparent, explainable clinical triage recommendations that empower clinicians while preserving independent clinical judgment.')}</p>
        </div>

        <!-- Compliance Item 3: openFDA -->
        <div class="compliance-card">
          <div class="compliance-header">
            <div class="compliance-icon-wrap">
              <Pill size={22} aria-hidden="true" />
            </div>
            <span class="compliance-badge-tag">{t('landing.complianceOpenFdaBadge', 'Official openFDA API')}</span>
          </div>
          <h3 class="compliance-item-title">{t('landing.complianceOpenFdaTitle', 'Direct openFDA FAERS Safety Surveillance')}</h3>
          <p class="compliance-item-desc">{t('landing.complianceOpenFdaDesc', 'Real-time pharmacovigilance queries directly against official US FDA FAERS public endpoints, surfacing adverse drug interactions and black-box safety warnings with zero synthetic hallucinations.')}</p>
        </div>

        <!-- Compliance Item 4: AWS Healthcare -->
        <div class="compliance-card">
          <div class="compliance-header">
            <div class="compliance-icon-wrap">
              <Server size={22} aria-hidden="true" />
            </div>
            <span class="compliance-badge-tag">{t('landing.complianceAwsBadge', 'AWS Healthcare 2026')}</span>
          </div>
          <h3 class="compliance-item-title">{t('landing.complianceAwsTitle', 'AWS Healthcare Cloud Architecture')}</h3>
          <p class="compliance-item-desc">{t('landing.complianceAwsDesc', 'Hosted on HIPAA-eligible AWS cloud infrastructure utilizing isolated Virtual Private Clouds (VPCs), automated backup replication, encrypted storage, and PostgreSQL pgvector semantic retrieval.')}</p>
        </div>
      </div>

      <!-- Clinical Non-Diagnostic Disclaimer Banner -->
      <div class="clinical-disclaimer-banner">
        <ShieldCheck size={20} class="disclaimer-icon" aria-hidden="true" />
        <div class="disclaimer-content">
          <strong class="disclaimer-heading">{t('landing.complianceNoticeTitle', 'Clinical Governance & Truth Gate Notice:')}</strong>
          <p class="disclaimer-text">
            {t('landing.complianceDisclaimer', 'Clinical Disclaimer: RemoteCare Pro is a clinical triage and patient adherence monitoring platform designed for licensed healthcare professionals. It does not provide autonomous medical diagnoses, alter prescribed treatment protocols, or replace independent clinical judgment.')}
          </p>
        </div>
      </div>
    </section>

    <!-- Conversion Banner -->
    <section class="cta-banner" aria-labelledby="cta-banner-title">
      <div class="cta-banner-inner">
        <h2 id="cta-banner-title" class="cta-banner-title">{t('landing.ctaBannerTitle', 'Experience the Complete Golden Loop')}</h2>
        <p class="cta-banner-desc">{t('landing.ctaBannerSubtitle', 'Explore the live clinician dashboard and experience how RemoteCare Pro transforms surgical recovery.')}</p>
        <a href="/login" class="cta-banner-btn">
          <span>{t('landing.accessPortal', 'Access Clinician Portal')}</span>
          <ArrowRight size={18} aria-hidden="true" />
        </a>
      </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
      <p class="footer-text">{t('landing.footerText', 'RemoteCare Pro • Surgical Recovery & Telemetry Platform')} • {new Date().getFullYear()}</p>
    </footer>
  </div>
</Layout>

<style>
  .landing-page {
    background-color: #f8fafc;
    min-height: 100vh;
    color: #0f172a;
    display: flex;
    flex-direction: column;
  }
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: #ffffff;
    border-bottom: 1px solid #e2e8f0;
    padding: 12px 24px;
    box-shadow: 0 1px 3px rgba(15,23,42,0.05);
  }
  .header-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .brand-group {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .brand-plus {
    color: #0284c7;
    font-size: 24px;
    font-weight: 800;
  }
  .brand-name {
    font-size: 18px;
    font-weight: 700;
    color: #0f172a;
  }
  .header-right {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .header-login-btn {
    background-color: transparent;
    color: #334155;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 8px 14px;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
  }
  .header-cta-btn {
    background-color: #0284c7;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 2px 4px rgba(2,132,199,0.2);
  }
  .hero-section {
    padding: 64px 24px 48px;
    background-color: #ffffff;
    border-bottom: 1px solid #e2e8f0;
    text-align: center;
  }
  .hero-inner {
    max-width: 860px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: #e0f2fe;
    color: #0369a1;
    padding: 6px 14px;
    border-radius: 9999px;
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 20px;
  }
  .hero-title {
    font-size: clamp(2rem, 3.5vw + 1rem, 3.25rem);
    font-weight: 800;
    color: #0f172a;
    line-height: 1.15;
    letter-spacing: -0.025em;
    margin-bottom: 20px;
  }
  .hero-highlight {
    color: #0284c7;
  }
  .hero-subtitle {
    font-size: 17px;
    color: #475569;
    line-height: 1.6;
    max-width: 66ch;
    margin-bottom: 32px;
  }
  .hero-cta-group {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 48px;
  }
  .primary-cta {
    background-color: #0284c7;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 14px 28px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(2,132,199,0.3);
    transition: background-color 0.15s ease;
  }
  .primary-cta:hover {
    background-color: #0369a1;
  }
  .secondary-cta {
    background-color: #f1f5f9;
    color: #334155;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 14px 28px;
