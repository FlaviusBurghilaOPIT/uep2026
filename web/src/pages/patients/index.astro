---
import AppLayout from '../../layouts/AppLayout.astro'
import { Users, FilePlus2, Printer, Pencil, UserX, UserCheck } from '@lucide/astro'
import { apiFetch } from '../../api/client'
import { createTranslator, isLanguage } from '../../i18n'
import '../../index.css'

const cookieLang = Astro.cookies.get('carepro_language')?.value
const lang = isLanguage(cookieLang) ? cookieLang : 'en'
const t = createTranslator(lang)

const cookieToken = Astro.cookies.get('carepro_token')?.value
if (!cookieToken) {
  return Astro.redirect('/login')
}

const successMsg = Astro.url.searchParams.get('msg')
const successText =
  successMsg === 'updated'
    ? t('patients.savedBanner', 'Patient details saved.')
    : successMsg === 'deactivated'
      ? t('patients.deactivatedBanner', 'Patient deactivated. They no longer appear in the triage queue.')
      : successMsg === 'reactivated'
        ? t('patients.reactivatedBanner', 'Patient reactivated.')
        : null

let patients: any[] = []
let cases: any[] = []

try {
  const [pList, cList] = await Promise.all([
    apiFetch<any[]>('/patients', { token: cookieToken }).catch(() => []),
    apiFetch<any[]>('/cases', { token: cookieToken }).catch(() => [])
  ])
  patients = pList || []
  cases = cList || []
} catch {
  patients = []
  cases = []
}
---

<AppLayout title={`${t('patients.title', 'Patients Cohort')} — RemoteCare Pro`}>
  <div class="patients-page">
    {successText && (
      <div class="success-banner" role="status">{successText}</div>
    )}

    <div class="header">
      <div>
        <h1 class="title">{t('patients.title', 'Patient Cohort Management')}</h1>
        <p class="subtitle">{t('patients.subtitle', 'Enrolled surgical patients, onboarding codes, and adherence records')}</p>
      </div>
      <a href="/patients/new" class="new-patient-btn">
        <FilePlus2 size={16} aria-hidden="true" />
        <span>{t('patients.newPatient', '+ Add New Patient')}</span>
      </a>
    </div>

    <!-- Patients Roster Table -->
    <div class="table-card">
      <div class="table-header-row">
        <h3 class="table-title">{t('patients.tableTitle', 'Active Patient Registry')}</h3>
        <div class="search-wrap">
          <input
            type="text"
            id="patient-search"
            class="search-input"
            placeholder={t('patients.searchPlaceholder', 'Search patients...')}
            aria-label={t('patients.searchPlaceholder', 'Search patients...')}
          />
        </div>
      </div>

      <div class="table-container">
        <table class="data-table" id="patients-table">
          <caption class="sr-only">{t('patients.tableTitle', 'Active Patient Registry')}</caption>
          <thead>
            <tr>
              <th>{t('patients.colName', 'Patient Name')}</th>
              <th>{t('patients.colDob', 'Date of Birth')}</th>
              <th>{t('patients.colStatus', 'Status / Invite Code')}</th>
              <th>{t('patients.colCases', 'Associated Cases')}</th>
              <th>{t('patients.colExports', 'Clinical Exports')}</th>
              <th>{t('patients.colActions', 'Actions')}</th>
            </tr>
          </thead>
          <tbody id="patients-tbody">
            {patients.length === 0 ? (
              <tr>
                <td colspan="6" class="empty-cell">
                  {t('patients.noPatients', 'No enrolled patients found. Click "+ Add New Patient" to enroll.')}
                </td>
              </tr>
            ) : (
              patients.map((p) => {
                const pCases = cases.filter((c) => c.patient_id === p.id)
                const isInactive = p.status === 'inactive'
                return (
                  <tr class="patient-row" data-name={(p.full_name || '').toLowerCase()} data-email={(p.email || '').toLowerCase()} data-patient-id={p.id}>
                    <td>
                      <div class="patient-cell-name">{p.full_name}</div>
                      <div class="patient-cell-sub">{p.email || p.phone || t('patients.noContact', 'No direct contact')}</div>
                    </td>
                    <td>{p.date_of_birth || 'N/A'}</td>
                    <td>
                      {isInactive ? (
                        <span class="invite-badge inactive-badge" id={`status-badge-${p.id}`}>
                          {t('patients.inactiveBadge', 'INACTIVE')}
                        </span>
                      ) : p.invite_code ? (
                        <div class="otp-cell">
                          <span class="invite-badge otp-badge" id={`status-badge-${p.id}`} title="Enter this 6-digit OTP code in the Flutter mobile companion">
                            OTP: <strong>{p.invite_code}</strong>
                          </span>
                        </div>
                      ) : (
                        <span class="invite-badge active-badge" id={`status-badge-${p.id}`}>
                          {t('patients.activeBadge', 'ACTIVE')}
                        </span>
                      )}
                    </td>
                    <td>
                      {pCases.length > 0 ? (
                        pCases.map((c) => (
                          <a href={`/cases/${c.id}`} class="case-link">
                            {c.surgery_type} &rarr;
                          </a>
                        ))
                      ) : (
                        <span class="no-cases-text">{t('patients.noCases', 'No active cases')}</span>
                      )}
                    </td>
                    <td>
                      <button
                        type="button"
                        class="export-btn print-patient-btn"
                        data-name={p.full_name}
                        aria-label={`${t('patients.printPdf', 'Export PDF')} for ${p.full_name}`}
                      >
                        <Printer size={13} aria-hidden="true" />
                        <span>{t('patients.printPdf', 'Export PDF')}</span>
                      </button>
                    </td>
                    <td>
                      <div class="row-actions">
                        <a href={`/patients/${p.id}/edit`} class="row-action-btn edit-row-btn" aria-label={`Edit ${p.full_name}`}>
                          <Pencil size={13} aria-hidden="true" />
                          <span>{t('patients.edit', 'Edit')}</span>
                        </a>
                        {isInactive ? (
                          <button
                            type="button"
                            class="row-action-btn reactivate-row-btn"
                            data-reactivate-id={p.id}
                            aria-label={`Reactivate ${p.full_name}`}
                          >
                            <UserCheck size={13} aria-hidden="true" />
                            <span>{t('patients.reactivate', 'Reactivate')}</span>
                          </button>
                        ) : (
                          <button
                            type="button"
                            class="row-action-btn deactivate-row-btn"
                            data-deactivate-id={p.id}
                            data-deactivate-name={p.full_name}
                            aria-label={`Deactivate ${p.full_name}`}
                          >
                            <UserX size={13} aria-hidden="true" />
                            <span>{t('patients.deactivate', 'Deactivate')}</span>
                          </button>
                        )}
                      </div>
                    </td>
                  </tr>
                )
              })
            )}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Confirm Deactivate Modal -->
  <div id="confirm-modal" class="modal-overlay hidden" role="dialog" aria-modal="true" aria-labelledby="confirm-modal-title">
    <div class="modal-card">
      <h3 id="confirm-modal-title" class="modal-title">{t('editPatient.confirmTitle', 'Deactivate this patient?')}</h3>
      <p class="modal-text" id="confirm-modal-text"></p>
      <div class="modal-actions">
        <button type="button" class="btn-cancel" id="confirm-cancel-btn">{t('cta.cancel', 'Cancel')}</button>
        <button type="button" class="btn-confirm-deactivate" id="confirm-deactivate-btn">{t('editPatient.deactivate', 'Deactivate Patient')}</button>
      </div>
    </div>
  </div>
</AppLayout>

<style>
  .patients-page {
    padding: 32px;
    max-width: 1300px;
    margin: 0 auto;
  }
  .header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 24px;
  }
  .title {
    font-size: 26px;
    font-weight: 700;
    color: #0f172a;
    margin: 0;
  }
  .subtitle {
    font-size: 14px;
    color: #64748b;
    margin: 4px 0 0;
  }
  .new-patient-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: #0284c7;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 10px 18px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    box-shadow: 0 2px 4px rgba(2,132,199,0.2);
    transition: background-color var(--duration-press) var(--ease-out), transform var(--duration-press) var(--ease-out);
  }
  .new-patient-btn:hover {
    background-color: #0369a1;
  }
  .new-patient-btn:active {
    transform: scale(0.97);
  }
  .table-card {
    background-color: #ffffff;
    border-radius: 12px;
    border: 1px solid #e2e8f0;
    box-shadow: 0 1px 3px rgba(15,23,42,0.05);
    overflow: hidden;
  }
  .table-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 20px;
    border-bottom: 1px solid #e2e8f0;
  }
  .table-title {
    font-size: 16px;
    font-weight: 700;
    color: #0f172a;
    margin: 0;
  }
  .search-input {
    padding: 8px 12px;
    border-radius: 6px;
    border: 1px solid #cbd5e1;
    font-size: 13px;
    outline: none;
    width: 240px;
  }
  .search-input:focus {
    border-color: #0284c7;
  }
  .table-container {
    overflow-x: auto;
  }
  .data-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: 14px;
  }
  .data-table th {
    background-color: #f8fafc;
    color: #475569;
    font-weight: 600;
    padding: 12px 18px;
    border-bottom: 1px solid #e2e8f0;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .data-table td {
    padding: 14px 18px;
    border-bottom: 1px solid #f1f5f9;
    color: #1e293b;
    vertical-align: middle;
  }
  .data-table tr:hover {
    background-color: #f8fafc;
  }
  .patient-cell-name {
    font-weight: 700;
    color: #0f172a;
  }
  .patient-cell-sub {
    font-size: 12px;
    color: #64748b;
  }
  .otp-cell {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .invite-badge {
    padding: 3px 8px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 700;
    display: inline-block;
  }
  .otp-badge {
    background: #f0fdf4;
    color: #15803d;
    border: 1px solid #86efac;
    font-family: monospace;
    letter-spacing: 0.05em;
  }
  .active-badge {
    background: #f1f5f9;
    color: #475569;
    border: 1px solid #e2e8f0;
  }
  .case-link {
    display: inline-block;
    margin-right: 8px;
    color: #0284c7;
    text-decoration: none;
    font-weight: 600;
    transition: color var(--duration-press) var(--ease-out);
  }
  .case-link:hover {
    color: #0369a1;
  }
  .no-cases-text {
    color: #94a3b8;
    font-size: 13px;
  }
  .export-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: #f1f5f9;
    color: #334155;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color var(--duration-press) var(--ease-out), border-color var(--duration-press) var(--ease-out), transform var(--duration-press) var(--ease-out);
  }
  .export-btn:hover {
    background-color: #e2e8f0;
  }
  .export-btn:active {
    transform: scale(0.95);
  }
  .empty-cell {
    text-align: center;
    color: #64748b;
    padding: 32px;
  }

  .hidden {
    display: none !important;
  }

  .success-banner {
    background-color: #f0fdf4;
    color: #15803d;
    border: 1px solid #86efac;
    padding: 10px 16px;
    border-radius: 8px;
    font-size: 13.5px;
    font-weight: 600;
    margin-bottom: 16px;
  }

  .inactive-badge {
    background: #f1f5f9;
    color: #64748b;
    border: 1px solid #cbd5e1;
  }

  .row-actions {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }

  .row-action-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
    transition: background-color var(--duration-press) var(--ease-out);
  }

  .edit-row-btn {
    background: #f1f5f9;
    color: #334155;
    border: 1px solid #cbd5e1;
  }
  .edit-row-btn:hover { background-color: #e2e8f0; }

  .deactivate-row-btn {
    background: #fef2f2;
    color: #991b1b;
    border: 1px solid #fecaca;
  }
  .deactivate-row-btn:hover { background-color: #fee2e2; }

  .reactivate-row-btn {
    background: #f0fdf4;
    color: #15803d;
    border: 1px solid #bbf7d0;
  }
  .reactivate-row-btn:hover { background-color: #dcfce7; }

  .modal-overlay {
    position: fixed;
    inset: 0;
    background-color: rgba(15,23,42,0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 100;
  }
  .modal-card {
    background-color: #ffffff;
    border-radius: 12px;
    padding: 24px;
    width: 100%;
    max-width: 420px;
    box-shadow: 0 20px 25px -5px rgba(15,23,42,0.15);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .modal-title { font-size: 17px; font-weight: 700; color: #0f172a; margin: 0; }
  .modal-text { font-size: 13.5px; color: #64748b; margin: 0; }
  .modal-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 8px; }
  .btn-cancel {
    padding: 9px 16px;
    background-color: #f1f5f9;
    color: #334155;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
  }
  .btn-confirm-deactivate {
    padding: 9px 16px;
    background-color: #dc2626;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
  }
  .btn-confirm-deactivate:hover { background-color: #b91c1c; }
</style>

<script>
  function initPatientsPage() {
    const searchInput = document.getElementById('patient-search') as HTMLInputElement
    if (searchInput) {
      searchInput.addEventListener('input', () => {
        const query = searchInput.value.toLowerCase().trim()
        const rows = document.querySelectorAll<HTMLTableRowElement>('.patient-row')
        rows.forEach(row => {
          const name = row.getAttribute('data-name') || ''
          const email = row.getAttribute('data-email') || ''
          if (!query || name.includes(query) || email.includes(query)) {
            row.style.display = ''
          } else {
            row.style.display = 'none'
          }
        })
      })
    }

    const printBtns = document.querySelectorAll('.print-patient-btn')
    printBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        window.print()
      })
    })

    function getToken(): string {
      const cookieToken = document.cookie.split('; ').find((row) => row.startsWith('carepro_token='))?.split('=')[1]
      return localStorage.getItem('token') || cookieToken || ''
    }

    const confirmModal = document.getElementById('confirm-modal')
    const confirmModalText = document.getElementById('confirm-modal-text')
    const confirmCancelBtn = document.getElementById('confirm-cancel-btn')
    const confirmDeactivateBtn = document.getElementById('confirm-deactivate-btn') as HTMLButtonElement
    let pendingDeactivateId: string | null = null

    document.querySelectorAll<HTMLButtonElement>('.deactivate-row-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        pendingDeactivateId = btn.getAttribute('data-deactivate-id')
        const name = btn.getAttribute('data-deactivate-name') || 'This patient'
        if (confirmModalText) {
          confirmModalText.textContent = `${name} will disappear from the active triage queue. Their medical history stays intact and this can be reversed at any time.`
        }
        confirmModal?.classList.remove('hidden')
      })
    })

    confirmCancelBtn?.addEventListener('click', () => {
      confirmModal?.classList.add('hidden')
      pendingDeactivateId = null
    })
    confirmModal?.addEventListener('click', (e) => {
      if (e.target === confirmModal) {
        confirmModal.classList.add('hidden')
        pendingDeactivateId = null
      }
    })

    confirmDeactivateBtn?.addEventListener('click', async () => {
      if (!pendingDeactivateId) return
      confirmDeactivateBtn.disabled = true
      try {
        const res = await fetch(`/api/patients/${pendingDeactivateId}`, {
          method: 'DELETE',
          headers: { Authorization: `Bearer ${getToken()}` },
        })
        if (!res.ok) throw new Error('Failed to deactivate patient.')
        window.location.href = '/patients?msg=deactivated'
      } catch {
        confirmDeactivateBtn.disabled = false
        confirmModal?.classList.add('hidden')
      }
    })

    document.querySelectorAll<HTMLButtonElement>('.reactivate-row-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const patientId = btn.getAttribute('data-reactivate-id')
        if (!patientId) return
        btn.disabled = true
        try {
          const res = await fetch(`/api/patients/${patientId}/reactivate`, {
            method: 'POST',
            headers: { Authorization: `Bearer ${getToken()}` },
          })
          if (!res.ok) throw new Error('Failed to reactivate patient.')
          window.location.href = '/patients?msg=reactivated'
        } catch {
          btn.disabled = false
        }
      })
    })
  }

  initPatientsPage()
  document.addEventListener('astro:page-load', initPatientsPage)
</script>
