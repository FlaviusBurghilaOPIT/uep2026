---
import AppLayout from '../layouts/AppLayout.astro'
import {
  CheckCircle2,
  AlertCircle,
  TriangleAlert,
  Search,
  Phone,
  RotateCw,
  Sparkles,
  Stethoscope,
  Pill,
  Activity,
  ArrowRight,
  ShieldAlert,
  X,
  FileCheck2,
  Clock,
  HeartPulse
} from '@lucide/astro'
import { apiFetch } from '../api/client'
import { createTranslator, isLanguage } from '../i18n'
import '../index.css'

const cookieLang = Astro.cookies.get('carepro_language')?.value
const lang = isLanguage(cookieLang) ? cookieLang : 'en'
const t = createTranslator(lang)

const cookieToken = Astro.cookies.get('carepro_token')?.value
if (!cookieToken) {
  return Astro.redirect('/login')
}

let patients: any[] = []
let cases: any[] = []
let triageItems: any[] = []

try {
  const [pRes, cRes] = await Promise.all([
    apiFetch<any[]>('/patients', { token: cookieToken }).catch(() => []),
    apiFetch<any[]>('/cases', { token: cookieToken }).catch(() => [])
  ])
  patients = pRes || []
  cases = cRes || []

  // Fetch telemetry (symptoms & adherence) for each patient
  const telemetryPromises = patients.map(async (p) => {
    const pCase = cases.find((c) => c.patient_id === p.id)
    let symptoms: any[] = []
    let doseLogs: any[] = []
    let medications: any[] = []

    if (pCase) {
      const [sRes, dRes, mRes] = await Promise.all([
        apiFetch<any[]>(`/symptoms/patients/${p.id}/symptoms`, { token: cookieToken }).catch(() => []),
        apiFetch<any[]>(`/adherence/patients/${p.id}`, { token: cookieToken }).catch(() => []),
        apiFetch<any[]>(`/medications/cases/${pCase.id}`, { token: cookieToken }).catch(() => [])
      ])
      symptoms = sRes || []
      doseLogs = dRes || []
      medications = mRes || []
    }

    const latestSymptom = symptoms.length > 0
      ? symptoms.sort((a, b) => new Date(b.created_at || '').getTime() - new Date(a.created_at || '').getTime())[0]
      : null

    const completedLogs = doseLogs.filter((l) => ['taken', 'missed', 'skipped'].includes(l.status?.toLowerCase()))
    const takenCount = doseLogs.filter((l) => l.status?.toLowerCase() === 'taken').length
    const missedCount = doseLogs.filter((l) => ['missed', 'skipped'].includes(l.status?.toLowerCase())).length
    const adherenceRate = completedLogs.length > 0 ? Math.round((takenCount / completedLogs.length) * 100) : 100

    let priority: 'red' | 'amber' | 'green' = 'green'
    const triggers: string[] = []

    const feeling = latestSymptom?.feeling?.toLowerCase() || ''
    if (feeling === 'bad' || feeling === 'severe') {
      priority = 'red'
      triggers.push(t('triage.reasonSeverePain', 'Severe post-op pain or acute symptom reported'))
    } else if (feeling === 'not_great') {
      priority = 'amber'
      triggers.push(t('triage.reasonDiscomfort', 'Patient reported feeling "Not Great" on latest check-in'))
    }

    if (missedCount >= 2 || adherenceRate < 60) {
      priority = 'red'
      triggers.push(`${missedCount} medication doses missed (${adherenceRate}% adherence)`)
    } else if (missedCount === 1 || adherenceRate < 80) {
      if (priority !== 'red') priority = 'amber'
      triggers.push(`1 medication dose missed (${adherenceRate}% adherence)`)
    }

    return {
      patient: p,
      case: pCase,
      symptoms,
      latestSymptom,
      doseLogs,
      medications,
      adherenceRate,
      missedCount,
      priority,
      triggers
    }
  })

  triageItems = await Promise.all(telemetryPromises)
} catch {
  patients = []
  cases = []
  triageItems = []
}

const redItems = triageItems.filter((item) => item.priority === 'red')
const amberItems = triageItems.filter((item) => item.priority === 'amber')
const attentionItems = [...redItems, ...amberItems]
const stableItems = triageItems.filter((item) => item.priority === 'green')
const totalPatients = patients.length
---

<AppLayout title={`${t('triage.title', 'Triage Dashboard')} — RemoteCare Pro`}>
  <div class="dashboard-page">
    <!-- Header -->
    <header class="header">
      <div>
        <div class="title-row">
          <h1 class="title">{t('triage.title', 'Clinical Triage Dashboard')}</h1>
          <span class="clinical-live-tag">
            <span class="pulse-dot"></span>
            {t('triage.liveConnected', 'Live telemetry connected')}
          </span>
        </div>
        <p class="subtitle">{t('triage.subtitle', 'Patients who need attention, first • Real-time recovery exceptions & automated triage roster')}</p>
      </div>

      <div class="header-actions">
        <button class="refresh-btn" id="refresh-btn" aria-label={t('triage.refresh', 'Refresh')}>
          <RotateCw size={15} id="refresh-icon" aria-hidden="true" />
          <span>{t('triage.refresh', 'Refresh Roster')}</span>
        </button>

        <button class="ai-summary-btn" id="ai-summary-btn" aria-label={t('triage.aiSummary', 'Clinical Cohort Synthesis')}>
          <Sparkles size={16} class="btn-sparkle" aria-hidden="true" />
          <span id="ai-summary-btn-text">{t('triage.aiSummary', 'Clinical Cohort Synthesis')}</span>
        </button>
      </div>
    </header>

    <!-- AI Clinical Synthesis Intelligence Drawer -->
    <section class="ai-summary-card hidden" id="ai-summary-box" role="region" aria-label="Clinical Cohort Intelligence Brief">
      <div class="ai-summary-header">
        <div class="ai-header-left">
          <div class="ai-header-icon">
            <Sparkles size={18} aria-hidden="true" />
          </div>
          <div>
            <h3 class="ai-summary-title">{t('triage.aiSummaryTitle', 'Clinical Cohort Intelligence Brief')}</h3>
            <p class="ai-summary-sub">Automated multi-patient telemetry synthesis & recovery protocol verification</p>
          </div>
        </div>
        <div class="ai-header-actions">
          <span class="ai-badge-verified">
            <HeartPulse size={13} aria-hidden="true" />
            <span>Clinical Intelligence Engine</span>
          </span>
          <button type="button" class="ai-close-icon-btn" id="ai-top-close-btn" aria-label="Close summary">
            <X size={16} aria-hidden="true" />
          </button>
        </div>
      </div>

      <!-- Container where formatted structured HTML is injected -->
      <div class="ai-summary-content-wrap" id="ai-summary-content">
        <!-- Render initial skeleton when opening -->
        <div class="skeleton-brief-loader">
          <div class="skeleton skeleton-title"></div>
          <div class="skeleton skeleton-text" style="width: 95%;"></div>
          <div class="skeleton skeleton-text" style="width: 80%;"></div>
          <div class="skeleton skeleton-text short"></div>
        </div>
      </div>
    </section>

    <!-- Stats KPI Grid -->
    <div class="stats-grid">
      <div class="stat-card stat-red">
        <div class="stat-card-top">
          <span class="stat-label">{t('triage.highPriority', 'Critical Priority')}</span>
          <AlertCircle size={18} class="stat-icon-red" aria-hidden="true" />
        </div>
        <div class="stat-number" id="count-red">{redItems.length}</div>
        <div class="stat-sub">{redItems.length > 0 ? 'Immediate clinical review required' : 'Zero critical exceptions'}</div>
      </div>

      <div class="stat-card stat-amber">
        <div class="stat-card-top">
          <span class="stat-label">{t('triage.mediumPriority', 'Medium Priority')}</span>
          <TriangleAlert size={18} class="stat-icon-amber" aria-hidden="true" />
        </div>
        <div class="stat-number" id="count-amber">{amberItems.length}</div>
        <div class="stat-sub">{amberItems.length > 0 ? 'Discomfort or adherence flagged' : 'No moderate flags'}</div>
      </div>

      <div class="stat-card stat-blue">
        <div class="stat-card-top">
          <span class="stat-label">{t('triage.totalActive', 'Total Monitored Patients')}</span>
          <Activity size={18} class="stat-icon-blue" aria-hidden="true" />
        </div>
        <div class="stat-number" id="count-total">{totalPatients}</div>
        <div class="stat-sub">Active surgical recovery cohort</div>
      </div>

      <div class="stat-card stat-green">
        <div class="stat-card-top">
          <span class="stat-label">{t('triage.medianResponse', 'Median Resolution Time')}</span>
          <Clock size={18} class="stat-icon-green" aria-hidden="true" />
        </div>
        <div class="stat-number" id="median-response-time">48s</div>
        <div class="stat-sub">{t('triage.responseTarget', 'Target < 60 seconds')}</div>
      </div>
    </div>

    <!-- Controls Bar: Search & Priority Filter Tabs -->
    <div class="controls-bar">
      <div class="search-container">
        <Search size={16} class="search-icon" aria-hidden="true" />
        <input
          type="text"
          id="search-input"
          class="search-input"
          placeholder={t('triage.searchPlaceholder', 'Filter by patient name, surgery, or phone...')}
          aria-label={t('triage.searchPlaceholder', 'Filter by patient name, surgery, or phone...')}
        />
      </div>

      <div class="tab-group" role="tablist" aria-label="Filter Priority">
        <button class="tab-btn active" data-tab="all" role="tab" aria-selected="true">
          <span>{t('triage.tabAll', 'All Alerts')}</span>
          <span class="tab-badge" id="tab-count-all">{totalPatients}</span>
        </button>
        <button class="tab-btn tab-btn-red" data-tab="red" role="tab" aria-selected="false">
          <AlertCircle size={14} aria-hidden="true" />
          <span>{t('triage.tabRed', 'Critical Priority')}</span>
          <span class="tab-badge badge-red" id="tab-count-red">{redItems.length}</span>
        </button>
        <button class="tab-btn tab-btn-amber" data-tab="amber" role="tab" aria-selected="false">
          <TriangleAlert size={14} aria-hidden="true" />
          <span>{t('triage.tabAmber', 'Medium Priority')}</span>
          <span class="tab-badge badge-amber" id="tab-count-amber">{amberItems.length}</span>
        </button>
        <button class="tab-btn tab-btn-stable" data-tab="stable" role="tab" aria-selected="false">
          <CheckCircle2 size={14} aria-hidden="true" />
          <span>{t('triage.statusStable', 'Stable Roster')}</span>
          <span class="tab-badge badge-green" id="tab-count-stable">{stableItems.length}</span>
        </button>
      </div>
    </div>

    <!-- 1. NEEDS ATTENTION / TRIAGE EXCEPTION QUEUE -->
    <section class="section" id="triage-queue-section">
      <div class="section-title-row">
        <div class="section-title-wrap">
          <div class="section-icon-wrap alert">
            <TriangleAlert size={18} aria-hidden="true" />
          </div>
          <div>
            <h2 class="section-title">{t('triage.queueTitle', 'Emergency Triage Queue')}</h2>
            <p class="section-sub">Patients flagged with symptom discomfort, severe pain, or medication non-adherence</p>
          </div>
        </div>
        <span class="priority-count-pill">{attentionItems.length} Exception{attentionItems.length !== 1 ? 's' : ''}</span>
      </div>

      <div id="triage-queue-list" class="triage-list">
        {attentionItems.length === 0 ? (
          <div class="empty-box" id="empty-state">
            <div class="empty-icon-circle">
              <CheckCircle2 size={28} aria-hidden="true" />
            </div>
            <h3 class="empty-title">All Patient Pathways Stable</h3>
            <p class="empty-text">{t('triage.allOnTrack', 'All patient recovery pathways are currently on track. No active triage exceptions.')}</p>
          </div>
        ) : (
          attentionItems.map((item) => {
            const p = item.patient
            const pCase = item.case
            const isRed = item.priority === 'red'
            return (
              <div
                class={`triage-card ${isRed ? 'card-priority-red' : 'card-priority-amber'} patient-card`}
                data-name={(p.full_name || '').toLowerCase()}
                data-priority={item.priority}
              >
                <!-- Priority Header Strip -->
                <div class="triage-card-header">
                  <div class="patient-main-info">
                    <div class="patient-avatar-box">
                      {(p.full_name || 'PT').slice(0, 2).toUpperCase()}
                    </div>
                    <div>
                      <div class="patient-name-line">
                        <h3 class="patient-card-name">{p.full_name}</h3>
                        <span class={`priority-badge ${isRed ? 'badge-critical' : 'badge-moderate'}`}>
                          {isRed ? 'CRITICAL EXCEPTION' : 'MODERATE ATTENTION'}
                        </span>
                      </div>
                      <p class="patient-meta-sub">
                        {t('patientCard.surgeryType', 'Procedure')}: <strong>{pCase?.surgery_type || 'Post-Op Recovery'}</strong> • {t('patients.dob', 'DOB')}: {p.date_of_birth || 'N/A'} • Phone: {p.phone || pCase?.emergency_contact_phone || 'N/A'}
                      </p>
                    </div>
                  </div>

                  <div class="adherence-gauge-wrap">
                    <div class="gauge-label-row">
                      <span class="gauge-label">Adherence</span>
                      <strong class="gauge-pct">{item.adherenceRate}%</strong>
                    </div>
                    <div class="progress-track">
                      <div
                        class={`progress-fill ${item.adherenceRate >= 80 ? 'success' : item.adherenceRate >= 50 ? 'warning' : 'danger'}`}
                        style={`width: ${item.adherenceRate}%;`}
                      ></div>
                    </div>
                  </div>
                </div>

                <!-- Exception Triggers Box -->
                <div class="triage-triggers-box">
                  <div class="trigger-label-row">
                    <ShieldAlert size={14} class="trigger-icon" aria-hidden="true" />
                    <span class="trigger-title">Clinical Escalation Triggers:</span>
                  </div>
                  <ul class="trigger-list">
                    {item.triggers.map((trig: string) => (
                      <li class="trigger-item">{trig}</li>
                    ))}
                  </ul>
                </div>

                <!-- Active Medications Chips -->
                {item.medications.length > 0 && (
                  <div class="card-meds-row">
                    <span class="meds-sub-label">Prescribed Regimen:</span>
                    <div class="meds-tags">
                      {item.medications.map((m: any) => (
                        <span class="med-tag">
                          <Pill size={12} aria-hidden="true" />
                          <span>{m.name} ({m.dose || 'Standard'})</span>
                        </span>
                      ))}
                    </div>
                  </div>
                )}

                <!-- Action Toolbar -->
                <div class="triage-card-footer">
                  <div class="footer-left-contact">
                    {p.phone || pCase?.emergency_contact_phone ? (
                      <a href={`tel:${p.phone || pCase?.emergency_contact_phone}`} class="action-btn-call" aria-label={`Call ${p.full_name}`}>
                        <Phone size={14} aria-hidden="true" />
                        <span>Call Patient</span>
                      </a>
                    ) : (
                      <span class="text-muted-contact">No phone registered</span>
                    )}
                  </div>

                  <div class="footer-right-actions">
                    <button
                      type="button"
                      class="action-btn-resolve"
                      data-patient-name={p.full_name}
                      data-patient-id={p.id}
                      data-case-id={pCase?.id}
                    >
                      <FileCheck2 size={15} aria-hidden="true" />
                      <span>{t('triage.resolveException', 'Document Outreach & Resolve')}</span>
                    </button>

                    <a href={pCase ? `/cases/${pCase.id}` : `/patients`} class="action-btn-review">
                      <span>{t('triage.reviewCase', 'Review Case')}</span>
                      <ArrowRight size={14} aria-hidden="true" />
                    </a>
                  </div>
                </div>
              </div>
            )
          })
        )}
      </div>
    </section>

    <!-- 2. STABLE PATIENT ROSTER -->
    <section class="section" id="stable-roster-section">
      <div class="section-title-row">
        <div class="section-title-wrap">
          <div class="section-icon-wrap stable">
            <CheckCircle2 size={18} aria-hidden="true" />
          </div>
          <div>
            <h2 class="section-title">{t('triage.stableRosterTitle', 'Stable Patient Roster')}</h2>
            <p class="section-sub">Patients with optimal medication compliance and positive check-in sentiments</p>
          </div>
        </div>
        <span class="stable-count-pill">{stableItems.length} Patient{stableItems.length !== 1 ? 's' : ''} Stable</span>
      </div>

      <div id="stable-patient-grid" class="stable-grid">
        {stableItems.length === 0 ? (
          <div class="empty-box full-grid-span">
            <p class="empty-text">{t('triage.noActivePatients', 'No patients currently in stable cohort.')}</p>
          </div>
        ) : (
          stableItems.map((item) => {
            const p = item.patient
            const pCase = item.case
            return (
              <div class="patient-card roster-card" data-name={(p.full_name || '').toLowerCase()} data-priority="stable">
                <div class="roster-header">
                  <div class="roster-identity">
                    <div class="roster-avatar">{(p.full_name || 'PT').slice(0, 2).toUpperCase()}</div>
                    <div>
                      <h4 class="roster-name">{p.full_name}</h4>
                      <span class="roster-sub-meta">{t('patientCard.surgeryType', 'Surgery')}: {pCase?.surgery_type || 'Post-Op'}</span>
                    </div>
                  </div>
                  <span class="status-badge-stable">STABLE</span>
                </div>

                <div class="roster-metrics">
                  <div class="metric-col">
                    <span class="metric-label">Adherence</span>
                    <strong class="metric-val text-green">{item.adherenceRate}%</strong>
                  </div>
                  <div class="metric-col">
                    <span class="metric-label">Latest Check-In</span>
                    <strong class="metric-val">{item.latestSymptom?.feeling?.toUpperCase() || 'OK'}</strong>
                  </div>
                </div>

                <div class="roster-footer">
                  <span class="dob-text">{t('patients.dob', 'DOB')}: {p.date_of_birth || 'N/A'}</span>
                  <a href={pCase ? `/cases/${pCase.id}` : `/patients`} class="view-case-link">
                    {t('patientCard.viewCase', 'View Case')} &rarr;
                  </a>
                </div>
              </div>
            )
          })
        )}
      </div>
    </section>
  </div>

  <!-- Resolution Outreach Modal -->
  <div id="resolution-modal" class="modal-overlay hidden" role="dialog" aria-modal="true" aria-labelledby="modal-title">
    <div class="modal-card">
      <div class="modal-header">
        <div class="modal-title-wrap">
          <Stethoscope size={20} class="modal-icon" aria-hidden="true" />
          <h3 id="modal-title" class="modal-title">{t('triage.resolveModalTitle', 'Document Clinical Outreach')}</h3>
        </div>
        <button type="button" class="modal-close-btn" id="modal-close-btn" aria-label="Close modal">
          <X size={18} aria-hidden="true" />
        </button>
      </div>

      <form id="resolution-form" class="modal-form">
        <p class="modal-patient-name" id="modal-patient-info"></p>

        <div class="form-group">
          <label class="form-label" for="outreach-channel">{t('triage.outreachMethod', 'Clinical Contact Method *')}</label>
          <select id="outreach-channel" class="modal-select" required>
            <option value="phone">{t('triage.outreachPhone', 'Phone Consultation with Patient / Family')}</option>
            <option value="sms">{t('triage.outreachSms', 'Secure Clinical SMS / Mobile Direct Message')}</option>
            <option value="visit">{t('triage.outreachVisit', 'In-Clinic / Bedside Review')}</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label" for="resolution-note">{t('triage.clinicalNote', 'Clinical Note & Care Plan Adjustment *')}</label>
          <textarea
            id="resolution-note"
            class="modal-textarea"
            rows="3"
            placeholder={t('triage.notePlaceholder', 'Document outreach summary (e.g. Consulted patient regarding nausea; advised taking analgesics with light food. Symptoms de-escalated)...')}
            required
            minlength="10"
          ></textarea>
          <span class="note-helper">Minimum 10 characters required for clinical audit compliance.</span>
        </div>

        <div class="modal-actions">
          <button type="button" class="btn-cancel" id="modal-cancel-btn">
            {t('cta.cancel', 'Cancel')}
          </button>
          <button type="submit" class="btn-submit-resolve" id="modal-submit-btn">
            <FileCheck2 size={16} aria-hidden="true" />
            <span>{t('cta.submit', 'Resolve & Archive Alert')}</span>
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Floating Toast Notification -->
  <div id="toast-msg" class="toast hidden" role="status" aria-live="polite"></div>
</AppLayout>

<style>
  .dashboard-page {
    padding: 32px;
    max-width: 1360px;
    margin: 0 auto;
  }

  .hidden {
    display: none !important;
  }

  .full-grid-span {
    grid-column: 1 / -1;
  }

  /* Header */
  .header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 26px;
    flex-wrap: wrap;
    gap: 16px;
  }

  .title-row {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .title {
    font-size: 26px;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .clinical-live-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background-color: #f0fdf4;
    border: 1px solid #86efac;
    color: #15803d;
    font-size: 11.5px;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 9999px;
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #16a34a;
    box-shadow: 0 0 6px #16a34a;
    animation: pulse-dot-anim 2s infinite;
  }

  @keyframes pulse-dot-anim {
    0% { transform: scale(0.9); opacity: 0.8; }
    50% { transform: scale(1.3); opacity: 1; }
    100% { transform: scale(0.9); opacity: 0.8; }
  }

  .subtitle {
    font-size: 14px;
    color: #64748b;
    margin: 6px 0 0;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .refresh-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 9px 15px;
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    color: #334155;
    cursor: pointer;
    transition: all 0.15s ease;
    box-shadow: 0 1px 2px rgba(15,23,42,0.05);
  }

  .refresh-btn:hover {
    background-color: #f8fafc;
    border-color: #94a3b8;
  }

  .ai-summary-btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 9px 16px;
    background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
    color: #ffffff;
    border: none;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(2, 132, 199, 0.35);
    transition: all 0.15s ease;
  }

  .ai-summary-btn:hover {
    background: linear-gradient(135deg, #0369a1 0%, #075985 100%);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(2, 132, 199, 0.4);
  }

  .btn-sparkle {
    color: #bae6fd;
  }

  /* AI Clinical Synthesis Card */
  .ai-summary-card {
    background: linear-gradient(180deg, #f0f9ff 0%, #ffffff 100%);
    border: 1px solid #bae6fd;
    border-radius: 14px;
    padding: 22px;
    margin-bottom: 28px;
    box-shadow: 0 4px 14px rgba(2, 132, 199, 0.08);
    position: relative;
    overflow: hidden;
  }

  .ai-summary-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 18px;
    padding-bottom: 14px;
    border-bottom: 1px solid #e0f2fe;
    gap: 16px;
  }

  .ai-header-left {
