  import { parseClinicalSummary, renderClinicalBriefHtml } from '../utils/clinicalSummaryFormatter'
  import { resolveTriageAlert } from '../api/client'
  import { trackEvent } from '../api/analytics'

  function initDashboard() {
    // Stable roster is collapsed by default — it needs zero action, so it
    // shouldn't compete with the triage queue for screen space.
    const stableToggleBtn = document.getElementById('stable-toggle-btn')
    const stableGrid = document.getElementById('stable-patient-grid')

    function setStableExpanded(expanded: boolean) {
      if (!stableGrid || !stableToggleBtn) return
      stableGrid.classList.toggle('hidden', !expanded)
      stableToggleBtn.setAttribute('aria-expanded', String(expanded))
    }

    stableToggleBtn?.addEventListener('click', () => {
      setStableExpanded(stableToggleBtn.getAttribute('aria-expanded') !== 'true')
    })

    // 1 & 2. Search and priority tab filters — combined so they never fight each other,
    // and a "no matches" message shows instead of a silent blank list.
    const searchInput = document.getElementById('search-input') as HTMLInputElement
    const tabs = document.querySelectorAll<HTMLButtonElement>('.tab-btn')
    const noResultsMsg = document.getElementById('no-results-msg')

    function getActiveTab(): string {
      return document.querySelector<HTMLButtonElement>('.tab-btn.active')?.getAttribute('data-tab') || 'all'
    }

    function applyFilters() {
      const query = (searchInput?.value || '').toLowerCase().trim()
      const activeTab = getActiveTab()
      const cards = document.querySelectorAll<HTMLElement>('.patient-card')
      const queueSection = document.getElementById('triage-queue-section')
      const stableSection = document.getElementById('stable-roster-section')

      if (activeTab === 'all') {
        if (queueSection) queueSection.style.display = ''
        if (stableSection) stableSection.style.display = ''
      } else if (activeTab === 'stable') {
        if (queueSection) queueSection.style.display = 'none'
        if (stableSection) stableSection.style.display = ''
      } else {
        if (queueSection) queueSection.style.display = ''
        if (stableSection) stableSection.style.display = 'none'
      }

      let anyVisible = false
      let stableMatchExists = false
      cards.forEach((card) => {
        const name = card.getAttribute('data-name') || ''
        const priority = card.getAttribute('data-priority') || ''
        const matchesTab = activeTab === 'all' || activeTab === priority
        const cardText = card.textContent?.toLowerCase() || ''
        const matchesQuery = !query || name.includes(query) || cardText.includes(query)
        const visible = matchesTab && matchesQuery
        card.style.display = visible ? '' : 'none'
        if (visible) {
          anyVisible = true
          if (priority === 'stable') stableMatchExists = true
        }
      })

      // Auto-open the stable roster when the clinician asks for it directly,
      // or when a search match is hiding inside it.
      if (activeTab === 'stable' || (query !== '' && stableMatchExists)) {
        setStableExpanded(true)
      }

      if (noResultsMsg) {
        noResultsMsg.classList.toggle('hidden', anyVisible || cards.length === 0)
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', applyFilters)
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabs.forEach((tb) => {
          tb.classList.remove('active')
          tb.setAttribute('aria-selected', 'false')
        })
        tab.classList.add('active')
        tab.setAttribute('aria-selected', 'true')
        applyFilters()
      })
    })

    // Restore search text, tab, and scroll position after a manual refresh so the
    // clinician doesn't lose their place in the roster.
    const savedSearch = sessionStorage.getItem('dashboard-search')
    const savedTab = sessionStorage.getItem('dashboard-tab')
    const savedScroll = sessionStorage.getItem('dashboard-scroll')

    if (savedTab) {
      tabs.forEach((tb) => {
        const isMatch = tb.getAttribute('data-tab') === savedTab
        tb.classList.toggle('active', isMatch)
        tb.setAttribute('aria-selected', String(isMatch))
      })
    }
    if (savedSearch && searchInput) {
      searchInput.value = savedSearch
    }
    if (savedSearch || savedTab) {
      applyFilters()
    }
    if (savedScroll) {
      window.scrollTo(0, parseInt(savedScroll, 10))
    }
    sessionStorage.removeItem('dashboard-search')
    sessionStorage.removeItem('dashboard-tab')
    sessionStorage.removeItem('dashboard-scroll')

    // 3. Refresh button — saves the clinician's place before reloading
    const refreshBtn = document.getElementById('refresh-btn')
    const refreshIcon = document.getElementById('refresh-icon')
    if (refreshBtn) {
      refreshBtn.addEventListener('click', () => {
        refreshBtn.classList.add('btn-loading')
        refreshBtn.setAttribute('disabled', 'true')
        if (refreshIcon) refreshIcon.classList.add('animate-spin')
        sessionStorage.setItem('dashboard-search', searchInput?.value || '')
        sessionStorage.setItem('dashboard-tab', getActiveTab())
        sessionStorage.setItem('dashboard-scroll', String(window.scrollY))
        window.location.reload()
      })
    }

    // 3b. Expand/collapse the full detail on a triage card
    document.querySelectorAll<HTMLButtonElement>('[data-expand-toggle]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const card = btn.closest('.triage-card')
        if (!card) return
        const nowExpanded = !card.classList.contains('expanded')
        card.classList.toggle('expanded', nowExpanded)
        btn.setAttribute('aria-expanded', String(nowExpanded))
        const label = btn.querySelector('span')
        if (label) label.textContent = nowExpanded ? 'Hide Details' : 'Details'
      })
    })

    // 3c. One-tap Acknowledge — a lightweight "seen" marker that doesn't require
    // writing a full clinical note. Optimistic UI: the badge swaps immediately,
    // telemetry is fire-and-forget per this app's analytics rules.
    document.querySelectorAll<HTMLButtonElement>('.action-btn-ack').forEach((btn) => {
      btn.addEventListener('click', () => {
        const patientId = btn.getAttribute('data-ack-patient-id')
        if (!patientId) return
        trackEvent('web.triage.patient_acknowledged', { patient_id: patientId })
        const badge = document.createElement('span')
        badge.className = 'ack-badge'
        badge.innerHTML = '✓ <span>Seen just now</span>'
        btn.replaceWith(badge)
      })
    })

    // 3d. Wire the existing (previously unused) view/call telemetry so the
    // "Median Resolution Time" KPI card reflects real activity.
    document.querySelectorAll<HTMLElement>('.triage-card').forEach((card) => {
      const patientId = card.getAttribute('data-patient-id')
      const severity = card.getAttribute('data-priority')
      if (patientId && (severity === 'red' || severity === 'amber')) {
        trackEvent('web.triage.exception_viewed', { patient_id: patientId, severity })
      }
    })

    document.querySelectorAll<HTMLAnchorElement>('.action-btn-call').forEach((link) => {
      link.addEventListener('click', () => {
        const patientId = link.closest('.triage-card')?.getAttribute('data-patient-id')
        if (patientId) trackEvent('web.triage.patient_called', { patient_id: patientId })
      })
    })

    // 4. Clinical Cohort Synthesis (AI Briefing)
    const aiBtn = document.getElementById('ai-summary-btn')
    const aiBtnText = document.getElementById('ai-summary-btn-text')
    const aiBox = document.getElementById('ai-summary-box')
    const aiContent = document.getElementById('ai-summary-content')
    const aiTopCloseBtn = document.getElementById('ai-top-close-btn')

    let lastRawSummary = ''

    function closeAiBrief() {
      aiBox?.classList.add('hidden')
    }

    if (aiTopCloseBtn) {
      aiTopCloseBtn.addEventListener('click', closeAiBrief)
    }

    if (aiBtn && aiBox && aiContent) {
      aiBtn.addEventListener('click', async () => {
        aiBox.classList.remove('hidden')
        aiBtn.setAttribute('disabled', 'true')
        aiBtn.classList.add('btn-loading')
        if (aiBtnText) aiBtnText.textContent = 'Synthesizing Telemetry...'

        // Render skeleton screen inside the summary box
        aiContent.innerHTML = `
          <div class="skeleton skeleton-title" style="width: 35%;"></div>
          <div class="skeleton skeleton-text" style="width: 95%;"></div>
          <div class="skeleton skeleton-text" style="width: 85%;"></div>
          <div class="skeleton skeleton-text short"></div>
        `

        try {
          const token = localStorage.getItem('token') || (document.cookie.match(/(^| )carepro_token=([^;]+)/)?.[2])
          const locale = document.cookie.match(/(?:^|; )carepro_language=([^;]*)/)?.[1] || ''
          const res = await fetch(`/api/ai/patients-summary?locale=${encodeURIComponent(locale)}`, {
            headers: { 'Authorization': `Bearer ${token}` }
          })

          if (res.ok) {
            const data = await res.json()
            const rawText = data.summary || data.text || 'Cohort telemetry active. All patient recovery plans monitored.'
            lastRawSummary = rawText

            const parsed = parseClinicalSummary(rawText)
            aiContent.innerHTML = renderClinicalBriefHtml(parsed)

            // Setup dynamic copy & close event listeners
            const copyBtn = document.getElementById('synthesis-copy-btn')
            const dismissBtn = document.getElementById('synthesis-close-btn')

            if (copyBtn) {
              copyBtn.addEventListener('click', () => {
                navigator.clipboard.writeText(lastRawSummary).then(() => {
                  showToast('✓ Clinical Brief copied to clipboard')
                })
              })
            }

            if (dismissBtn) {
              dismissBtn.addEventListener('click', closeAiBrief)
            }
          } else {
            aiContent.innerHTML = `
              <div class="synthesis-fallback">
                <p style="color: #b91c1c;">Unable to synthesize clinical cohort summary. Please check clinician permissions.</p>
              </div>
            `
          }
        } catch {
          aiContent.innerHTML = `
            <div class="synthesis-fallback">
              <p style="color: #b91c1c;">Unable to connect to clinical intelligence service. Please check network telemetry connection.</p>
            </div>
          `
        } finally {
          aiBtn.removeAttribute('disabled')
          aiBtn.classList.remove('btn-loading')
          if (aiBtnText) aiBtnText.textContent = 'Clinical Cohort Synthesis'
        }
      })
    }

    // 5. Resolve Exception Modal
    const modal = document.getElementById('resolution-modal')
    const modalCloseBtn = document.getElementById('modal-close-btn')
    const modalCancelBtn = document.getElementById('modal-cancel-btn')
    const modalForm = document.getElementById('resolution-form') as HTMLFormElement | null
    const modalPatientInfo = document.getElementById('modal-patient-info')
    const modalPatientId = document.getElementById('modal-patient-id') as HTMLInputElement | null
    const modalCaseId = document.getElementById('modal-case-id') as HTMLInputElement | null
    const modalPriority = document.getElementById('modal-patient-priority') as HTMLInputElement | null
    const modalSurgery = document.getElementById('modal-patient-surgery') as HTMLInputElement | null
    const modalDob = document.getElementById('modal-patient-dob') as HTMLInputElement | null
    const modalAdherence = document.getElementById('modal-patient-adherence') as HTMLInputElement | null
    const modalSymptom = document.getElementById('modal-patient-symptom') as HTMLInputElement | null
    const modalErrorMsg = document.getElementById('modal-error-msg')
    const modalSubmitBtn = document.getElementById('modal-submit-btn') as HTMLButtonElement | null
    const modalSubmitBtnText = document.getElementById('modal-submit-btn-text')
    let currentResolvingCard: HTMLElement | null = null

    function closeModal() {
      modal?.classList.add('hidden')
      currentResolvingCard = null
      if (modalErrorMsg) {
        modalErrorMsg.textContent = ''
        modalErrorMsg.classList.add('hidden')
      }
      if (modalSubmitBtn) {
        modalSubmitBtn.removeAttribute('disabled')
      }
      if (modalSubmitBtnText) {
        modalSubmitBtnText.textContent = 'Resolve & Archive Alert'
      }
    }

    if (modalCloseBtn) modalCloseBtn.addEventListener('click', closeModal)
    if (modalCancelBtn) modalCancelBtn.addEventListener('click', closeModal)

    const resolveButtons = document.querySelectorAll<HTMLButtonElement>('.action-btn-resolve')
    resolveButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const patientName = btn.getAttribute('data-patient-name') || 'Patient'
        const patientId = btn.getAttribute('data-patient-id') || ''
        const caseId = btn.getAttribute('data-case-id') || ''
        const priority = btn.getAttribute('data-priority') || 'red'
        const surgery = btn.getAttribute('data-surgery') || 'Post-Op'
        const dob = btn.getAttribute('data-dob') || 'N/A'
        const adherence = btn.getAttribute('data-adherence') || '100'
        const symptom = btn.getAttribute('data-symptom') || 'OK'

        if (modalPatientInfo) {
          modalPatientInfo.textContent = `Patient: ${patientName} (${priority === 'red' ? 'Critical Exception' : 'Moderate Exception'})`
        }
        if (modalPatientId) modalPatientId.value = patientId
        if (modalCaseId) modalCaseId.value = caseId
        if (modalPriority) modalPriority.value = priority
        if (modalSurgery) modalSurgery.value = surgery
        if (modalDob) modalDob.value = dob
        if (modalAdherence) modalAdherence.value = adherence
        if (modalSymptom) modalSymptom.value = symptom

        const noteEl = document.getElementById('resolution-note') as HTMLTextAreaElement | null
        if (noteEl) noteEl.value = ''

        if (modalErrorMsg) {
          modalErrorMsg.textContent = ''
          modalErrorMsg.classList.add('hidden')
        }

        currentResolvingCard = btn.closest('.triage-card')
        modal?.classList.remove('hidden')
        setTimeout(() => noteEl?.focus(), 50)
      })
    })

    if (modalForm) {
      modalForm.addEventListener('submit', async (e) => {
        e.preventDefault()
        const noteEl = document.getElementById('resolution-note') as HTMLTextAreaElement | null
        const channelEl = document.getElementById('outreach-channel') as HTMLSelectElement | null
        const noteVal = (noteEl?.value || '').trim()
        const channelVal = channelEl?.value || 'phone_call'
        const patientId = modalPatientId?.value || ''
        const caseId = modalCaseId?.value || ''
        const priority = modalPriority?.value || 'red'
        const surgery = modalSurgery?.value || 'Post-Op'
        const dob = modalDob?.value || 'N/A'
        const adherence = modalAdherence?.value || '100'
        const symptom = modalSymptom?.value || 'OK'
        const patientName = currentResolvingCard?.querySelector('.patient-card-name')?.textContent || 'Patient'

        if (noteVal.length < 10) {
          if (modalErrorMsg) {
            modalErrorMsg.textContent = 'Please enter at least 10 characters for the clinical note.'
            modalErrorMsg.classList.remove('hidden')
          }
          return
        }

        if (modalErrorMsg) {
          modalErrorMsg.classList.add('hidden')
        }

        if (modalSubmitBtn) modalSubmitBtn.setAttribute('disabled', 'true')
        if (modalSubmitBtnText) modalSubmitBtnText.textContent = 'Resolving...'

        try {
          // Call triage resolution API helper
          await resolveTriageAlert(patientId, {
            outreach_method: channelVal,
            clinical_note: noteVal
          })

          // In-place resolution: remove card from exception queue
          if (currentResolvingCard) {
            currentResolvingCard.style.transition = 'all 0.3s ease'
            currentResolvingCard.style.opacity = '0'
            currentResolvingCard.style.transform = 'translateY(-10px)'
            setTimeout(() => {
              currentResolvingCard?.remove()

              // Check if any exceptions remain
              const remainingCards = document.querySelectorAll('#triage-queue-list .triage-card')
              if (remainingCards.length === 0) {
                const queueList = document.getElementById('triage-queue-list')
                if (queueList) {
                  queueList.innerHTML = `
                    <div class="empty-box" id="empty-state">
                      <div class="empty-icon-circle">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="m9 12 2 2 4-4"/></svg>
                      </div>
                      <h3 class="empty-title">All Patient Pathways Stable</h3>
                      <p class="empty-text">All patient recovery pathways are currently on track. No active triage exceptions.</p>
                    </div>
                  `
                }
              }
            }, 300)
          }

          // Update KPI stats counts
          if (priority === 'red') {
            const redCountEl = document.getElementById('count-red')
            const tabRedEl = document.getElementById('tab-count-red')
            if (redCountEl) {
              const current = Math.max(0, parseInt(redCountEl.textContent || '0', 10) - 1)
              redCountEl.textContent = String(current)
            }
            if (tabRedEl) {
              const current = Math.max(0, parseInt(tabRedEl.textContent || '0', 10) - 1)
              tabRedEl.textContent = String(current)
            }
          } else {
            const amberCountEl = document.getElementById('count-amber')
            const tabAmberEl = document.getElementById('tab-count-amber')
            if (amberCountEl) {
              const current = Math.max(0, parseInt(amberCountEl.textContent || '0', 10) - 1)
              amberCountEl.textContent = String(current)
            }
            if (tabAmberEl) {
              const current = Math.max(0, parseInt(tabAmberEl.textContent || '0', 10) - 1)
              tabAmberEl.textContent = String(current)
            }
          }

          // Update priority count pill
          const pillEl = document.querySelector('#triage-queue-section .priority-count-pill')
          if (pillEl) {
            const currentTotal = Math.max(0, parseInt(pillEl.textContent || '0', 10) - 1)
            pillEl.textContent = `${currentTotal} Exception${currentTotal !== 1 ? 's' : ''}`
          }

          // Update stable roster counts
          const tabStableEl = document.getElementById('tab-count-stable')
          const stablePillEl = document.querySelector('#stable-roster-section .stable-count-pill')
          if (tabStableEl) {
            const current = parseInt(tabStableEl.textContent || '0', 10) + 1
            tabStableEl.textContent = String(current)
          }
          if (stablePillEl) {
            const current = parseInt(stablePillEl.textContent || '0', 10) + 1
            stablePillEl.textContent = `${current} Patient${current !== 1 ? 's' : ''} Stable`
          }

          // Add to Stable Patient Grid
          const stableGrid = document.getElementById('stable-patient-grid')
          if (stableGrid) {
            const emptyStable = stableGrid.querySelector('.empty-box')
            if (emptyStable) emptyStable.remove()

            const initials = patientName.slice(0, 2).toUpperCase()
            const caseHref = caseId ? `/cases/${caseId}` : `/patients`
            const newRosterCard = document.createElement('div')
            newRosterCard.className = 'patient-card roster-card'
            newRosterCard.setAttribute('data-name', patientName.toLowerCase())
            newRosterCard.setAttribute('data-priority', 'stable')
            newRosterCard.innerHTML = `
              <div class="roster-header">
                <div class="roster-identity">
                  <div class="roster-avatar">${initials}</div>
                  <div>
                    <h4 class="roster-name">${patientName}</h4>
                    <span class="roster-sub-meta">Surgery: ${surgery}</span>
                  </div>
                </div>
                <span class="status-badge-stable">STABLE</span>
              </div>
              <div class="roster-metrics">
                <div class="metric-col">
                  <span class="metric-label">Adherence</span>
                  <strong class="metric-val text-green">${adherence}%</strong>
                </div>
                <div class="metric-col">
                  <span class="metric-label">Latest Check-In</span>
                  <strong class="metric-val">${symptom}</strong>
                </div>
              </div>
              <div class="roster-footer">
                <span class="dob-text" title="DOB: ${dob}">Age: ${calcAgeClient(dob)}</span>
                <a href="${caseHref}" class="view-case-link">View Case &rarr;</a>
              </div>
            `
            stableGrid.prepend(newRosterCard)
            setStableExpanded(true)
          }

          // Update median resolution time dynamically
          try {
            const token = localStorage.getItem('token') || (document.cookie.match(/(^| )carepro_token=([^;]+)/)?.[2])
            const statRes = await fetch('/api/analytics/triage-response', {
              headers: token ? { 'Authorization': `Bearer ${token}` } : {}
            })
            if (statRes.ok) {
              const statData = await statRes.json()
              const medianEl = document.getElementById('median-response-time')
              if (medianEl && statData?.median_seconds) {
                medianEl.textContent = `${Math.round(statData.median_seconds)}s`
              }
            }
          } catch {
            // Ignore stats refresh failure
          }

          showToast('✓ Triage alert resolved & documented.')
          closeModal()
        } catch (err: any) {
          if (modalErrorMsg) {
            modalErrorMsg.textContent = err?.message || 'Failed to save triage resolution. Please try again.'
            modalErrorMsg.classList.remove('hidden')
          } else {
            showToast('⚠️ Failed to save triage resolution. Please try again.')
          }
          if (modalSubmitBtn) modalSubmitBtn.removeAttribute('disabled')
          if (modalSubmitBtnText) modalSubmitBtnText.textContent = 'Resolve & Archive Alert'
        }
      })
    }

    // 6. Age helper for the roster card built client-side after a Resolve action
    function calcAgeClient(dob: string): string {
      const birth = new Date(dob)
      if (isNaN(birth.getTime())) return '—'
      const now = new Date()
      let age = now.getFullYear() - birth.getFullYear()
      const monthDiff = now.getMonth() - birth.getMonth()
      if (monthDiff < 0 || (monthDiff === 0 && now.getDate() < birth.getDate())) age--
      return String(age)
    }

    // 7. Toast helper
    function showToast(msg: string) {
      const toast = document.getElementById('toast-msg')
      if (toast) {
        toast.textContent = msg
        toast.classList.remove('hidden')
        setTimeout(() => {
          toast.classList.add('hidden')
        }, 3500)
      }
    }
  }

  initDashboard()
  document.addEventListener('astro:page-load', initDashboard)
</script>
