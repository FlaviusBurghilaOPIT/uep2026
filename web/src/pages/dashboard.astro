    align-items: center;
    border-top: 1px solid #f1f5f9;
    padding-top: 8px;
  }

  .dob-text {
    font-size: 11.5px;
    color: #94a3b8;
  }

  .view-case-link {
    font-size: 12.5px;
    color: #0284c7;
    font-weight: 600;
    text-decoration: none;
  }

  /* Resolution Modal */
  .modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(15, 23, 42, 0.6);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2000;
    padding: 16px;
  }

  .modal-card {
    background-color: #ffffff;
    border-radius: 16px;
    box-shadow: 0 20px 25px -5px rgba(15,23,42,0.15);
    width: 100%;
    max-width: 520px;
    padding: 24px;
  }

  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
  }

  .modal-title-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  :global(.modal-icon) {
    color: #0284c7;
  }

  .modal-title {
    font-size: 17px;
    font-weight: 700;
    color: #0f172a;
    margin: 0;
  }

  .modal-close-btn {
    background: transparent;
    border: none;
    color: #94a3b8;
    cursor: pointer;
    padding: 4px;
    border-radius: 6px;
  }

  .modal-patient-name {
    font-size: 13.5px;
    font-weight: 600;
    color: #0284c7;
    background-color: #f0f9ff;
    border: 1px solid #bae6fd;
    padding: 8px 12px;
    border-radius: 6px;
    margin: 0 0 16px 0;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 16px;
  }

  .form-label {
    font-size: 13px;
    font-weight: 600;
    color: #334155;
  }

  .modal-select {
    padding: 9px 12px;
    border-radius: 8px;
    border: 1px solid #cbd5e1;
    font-size: 13.5px;
    color: #0f172a;
    outline: none;
  }

  .modal-textarea {
    padding: 10px 12px;
    border-radius: 8px;
    border: 1px solid #cbd5e1;
    font-size: 13.5px;
    color: #0f172a;
    outline: none;
    resize: vertical;
  }

  .note-helper {
    font-size: 11px;
    color: #64748b;
  }

  .modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 20px;
  }

  .btn-cancel {
    padding: 9px 16px;
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    color: #475569;
    cursor: pointer;
  }

  .btn-submit-resolve {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 9px 18px;
    background-color: #16a34a;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
  }

  /* Toast */
  .toast {
    position: fixed;
    bottom: 24px;
    right: 24px;
    background-color: #0f172a;
    color: #ffffff;
    padding: 12px 20px;
    border-radius: 8px;
    font-size: 13.5px;
    font-weight: 600;
    box-shadow: 0 10px 15px -3px rgba(15,23,42,0.3);
    z-index: 3000;
    animation: slide-up 0.2s ease forwards;
  }

  @keyframes slide-up {
    from { transform: translateY(100%); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }

  @media (max-width: 1024px) {
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .stable-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .stats-grid {
      grid-template-columns: 1fr;
    }
    .stable-grid {
      grid-template-columns: 1fr;
    }
    .controls-bar {
      flex-direction: column;
      align-items: stretch;
    }
    .search-container {
      width: 100%;
    }
  }
</style>

<script>
  import { parseClinicalSummary, renderClinicalBriefHtml } from '../utils/clinicalSummaryFormatter'

  function initDashboard() {
    // 1. Live Search filter
    const searchInput = document.getElementById('search-input') as HTMLInputElement
    if (searchInput) {
      searchInput.addEventListener('input', () => {
        const query = searchInput.value.toLowerCase().trim()
        const cards = document.querySelectorAll<HTMLElement>('.patient-card')
        cards.forEach((card) => {
          const name = card.getAttribute('data-name') || ''
          const cardText = card.textContent?.toLowerCase() || ''
          if (!query || name.includes(query) || cardText.includes(query)) {
            card.style.display = ''
          } else {
            card.style.display = 'none'
          }
        })
      })
    }

    // 2. Priority Tab filter
    const tabs = document.querySelectorAll<HTMLButtonElement>('.tab-btn')
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabs.forEach((t) => {
          t.classList.remove('active')
          t.setAttribute('aria-selected', 'false')
        })
        tab.classList.add('active')
        tab.setAttribute('aria-selected', 'true')

        const selectedTab = tab.getAttribute('data-tab')
        const cards = document.querySelectorAll<HTMLElement>('.patient-card')
        const queueSection = document.getElementById('triage-queue-section')
        const stableSection = document.getElementById('stable-roster-section')

        if (selectedTab === 'all') {
          if (queueSection) queueSection.style.display = ''
          if (stableSection) stableSection.style.display = ''
          cards.forEach((c) => (c.style.display = ''))
        } else if (selectedTab === 'red') {
          if (queueSection) queueSection.style.display = ''
          if (stableSection) stableSection.style.display = 'none'
          cards.forEach((c) => {
            c.style.display = c.getAttribute('data-priority') === 'red' ? '' : 'none'
          })
        } else if (selectedTab === 'amber') {
          if (queueSection) queueSection.style.display = ''
          if (stableSection) stableSection.style.display = 'none'
          cards.forEach((c) => {
            c.style.display = c.getAttribute('data-priority') === 'amber' ? '' : 'none'
          })
        } else if (selectedTab === 'stable') {
          if (queueSection) queueSection.style.display = 'none'
          if (stableSection) stableSection.style.display = ''
          cards.forEach((c) => {
            c.style.display = c.getAttribute('data-priority') === 'stable' ? '' : 'none'
          })
        }
      })
    })

    // 3. Refresh button
    const refreshBtn = document.getElementById('refresh-btn')
    const refreshIcon = document.getElementById('refresh-icon')
    if (refreshBtn) {
      refreshBtn.addEventListener('click', () => {
        refreshBtn.classList.add('btn-loading')
        refreshBtn.setAttribute('disabled', 'true')
        if (refreshIcon) refreshIcon.classList.add('animate-spin')
        window.location.reload()
      })
    }

    // 4. Clinical Cohort Synthesis (AI Briefing)
    const aiBtn = document.getElementById('ai-summary-btn')
    const aiBtnText = document.getElementById('ai-summary-btn-text')
    const aiBox = document.getElementById('ai-summary-box')
    const aiContent = document.getElementById('ai-summary-content')
    const aiTopCloseBtn = document.getElementById('ai-top-close-btn')

    let lastRawSummary = ''

    function closeAiBrief() {
      aiBox?.classList.add('hidden')
    }

    if (aiTopCloseBtn) {
      aiTopCloseBtn.addEventListener('click', closeAiBrief)
    }

    if (aiBtn && aiBox && aiContent) {
      aiBtn.addEventListener('click', async () => {
        aiBox.classList.remove('hidden')
        aiBtn.setAttribute('disabled', 'true')
        aiBtn.classList.add('btn-loading')
        if (aiBtnText) aiBtnText.textContent = 'Synthesizing Telemetry...'

        // Render skeleton screen inside the summary box
        aiContent.innerHTML = `
          <div class="skeleton skeleton-title" style="width: 35%;"></div>
          <div class="skeleton skeleton-text" style="width: 95%;"></div>
          <div class="skeleton skeleton-text" style="width: 85%;"></div>
          <div class="skeleton skeleton-text short"></div>
        `

        try {
          const token = localStorage.getItem('token') || (document.cookie.match(/(^| )carepro_token=([^;]+)/)?.[2])
          const res = await fetch('/api/ai/patients-summary', {
            headers: { 'Authorization': `Bearer ${token}` }
          })

          if (res.ok) {
            const data = await res.json()
            const rawText = data.summary || data.text || 'Cohort telemetry active. All patient recovery plans monitored.'
            lastRawSummary = rawText

            const parsed = parseClinicalSummary(rawText)
            aiContent.innerHTML = renderClinicalBriefHtml(parsed)

            // Setup dynamic copy & close event listeners
            const copyBtn = document.getElementById('synthesis-copy-btn')
            const dismissBtn = document.getElementById('synthesis-close-btn')

            if (copyBtn) {
              copyBtn.addEventListener('click', () => {
                navigator.clipboard.writeText(lastRawSummary).then(() => {
                  showToast('✓ Clinical Brief copied to clipboard')
                })
              })
            }

            if (dismissBtn) {
              dismissBtn.addEventListener('click', closeAiBrief)
            }
          } else {
            aiContent.innerHTML = `
              <div class="synthesis-fallback">
                <p style="color: #b91c1c;">Unable to synthesize clinical cohort summary. Please check clinician permissions.</p>
              </div>
            `
          }
        } catch {
          aiContent.innerHTML = `
            <div class="synthesis-fallback">
              <p style="color: #b91c1c;">Unable to connect to clinical intelligence service. Please check network telemetry connection.</p>
            </div>
          `
        } finally {
          aiBtn.removeAttribute('disabled')
          aiBtn.classList.remove('btn-loading')
          if (aiBtnText) aiBtnText.textContent = 'Clinical Cohort Synthesis'
        }
      })
    }

    // 5. Resolve Exception Modal
    const modal = document.getElementById('resolution-modal')
    const modalCloseBtn = document.getElementById('modal-close-btn')
    const modalCancelBtn = document.getElementById('modal-cancel-btn')
    const modalForm = document.getElementById('resolution-form')
    const modalPatientInfo = document.getElementById('modal-patient-info')
    let currentResolvingCard: HTMLElement | null = null

    function closeModal() {
      modal?.classList.add('hidden')
      currentResolvingCard = null
    }

    if (modalCloseBtn) modalCloseBtn.addEventListener('click', closeModal)
    if (modalCancelBtn) modalCancelBtn.addEventListener('click', closeModal)

    const resolveButtons = document.querySelectorAll<HTMLButtonElement>('.action-btn-resolve')
    resolveButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const patientName = btn.getAttribute('data-patient-name') || 'Patient'
        if (modalPatientInfo) modalPatientInfo.textContent = `Patient: ${patientName} (Clinical Exception)`
        currentResolvingCard = btn.closest('.triage-card')
        modal?.classList.remove('hidden')
      })
    })

    if (modalForm) {
      modalForm.addEventListener('submit', (e) => {
        e.preventDefault()
        const noteEl = document.getElementById('resolution-note') as HTMLTextAreaElement
        const noteVal = noteEl?.value || ''
        if (noteVal.length < 10) {
          alert('Please enter at least 10 characters for the clinical note.')
          return
        }

        if (currentResolvingCard) {
          currentResolvingCard.style.transition = 'all 0.3s ease'
          currentResolvingCard.style.opacity = '0'
          currentResolvingCard.style.transform = 'translateY(-10px)'
          setTimeout(() => {
            currentResolvingCard?.remove()
            showToast('✓ Triage exception resolved & clinical outreach documented')
          }, 300)
        }

        closeModal()
        if (noteEl) noteEl.value = ''
      })
    }

    // 6. Toast helper
    function showToast(msg: string) {
      const toast = document.getElementById('toast-msg')
      if (toast) {
        toast.textContent = msg
        toast.classList.remove('hidden')
        setTimeout(() => {
          toast.classList.add('hidden')
        }, 3500)
      }
    }
  }

  initDashboard()
  document.addEventListener('astro:page-load', initDashboard)
</script>
