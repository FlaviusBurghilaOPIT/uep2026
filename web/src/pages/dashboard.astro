---
import AppLayout from '../layouts/AppLayout.astro'
import {
  CheckCircle2,
  AlertCircle,
  TriangleAlert,
  Search,
  Phone,
  RotateCw,
  Sparkles,
  Stethoscope,
  Pill,
  Activity,
  ArrowRight,
  ShieldAlert,
  X,
  FileCheck2,
  Clock,
  HeartPulse,
  TrendingUp,
  TrendingDown,
  Eye,
  ChevronDown
} from '@lucide/astro'
import { apiFetch } from '../api/client'
import { createTranslator, isLanguage } from '../i18n'
import '../index.css'

const cookieLang = Astro.cookies.get('carepro_language')?.value
const lang = isLanguage(cookieLang) ? cookieLang : 'en'
const t = createTranslator(lang)

const cookieToken = Astro.cookies.get('carepro_token')?.value
if (!cookieToken) {
  return Astro.redirect('/login')
}

function calcAge(dob: string | null | undefined): number | null {
  if (!dob) return null
  const birth = new Date(dob)
  if (isNaN(birth.getTime())) return null
  const now = new Date()
  let age = now.getFullYear() - birth.getFullYear()
  const monthDiff = now.getMonth() - birth.getMonth()
  if (monthDiff < 0 || (monthDiff === 0 && now.getDate() < birth.getDate())) age--
  return age
}

function relativeTime(iso: string | null | undefined): string {
  if (!iso) return 'No check-in yet'
  const then = new Date(iso).getTime()
  if (isNaN(then)) return 'No check-in yet'
  const minutes = Math.floor((Date.now() - then) / 60000)
  if (minutes < 1) return 'Just now'
  if (minutes < 60) return `${minutes}m ago`
  const hours = Math.floor(minutes / 60)
  if (hours < 24) return `${hours}h ago`
  const days = Math.floor(hours / 24)
  return `${days}d ago`
}

// great < ok < not_great < bad/severe — used to rank check-in trend and triage urgency
const FEELING_RANK: Record<string, number> = { great: 0, ok: 1, not_great: 2, bad: 3, severe: 3 }

function urgencyScore(item: { latestSymptom: any; missedCount: number; adherenceRate: number }): number {
  const feeling = item.latestSymptom?.feeling?.toLowerCase() || ''
  let score = (FEELING_RANK[feeling] ?? 0) * 30
  score += item.missedCount * 15
  score += Math.max(0, 100 - item.adherenceRate) * 0.3
  return score
}

let patients: any[] = []
let cases: any[] = []
let triageItems: any[] = []
let triageStats: any = null

let ackByPatientId: Record<string, string> = {}

try {
  const [pRes, cRes, statRes, ackRes] = await Promise.all([
    apiFetch<any[]>('/patients', { token: cookieToken }).catch(() => []),
    apiFetch<any[]>('/cases', { token: cookieToken }).catch(() => []),
    apiFetch<any>('/analytics/triage-response', { token: cookieToken }).catch(() => null),
    apiFetch<any>('/analytics/triage-acknowledgements', { token: cookieToken }).catch(() => null)
  ])
  // Deactivated/discharged patients are no longer monitored — keep them off the triage board.
  patients = (pRes || []).filter((p: any) => p.status !== 'inactive')
  cases = cRes || []
  triageStats = statRes
  ackByPatientId = Object.fromEntries(
    (ackRes?.acknowledgements || []).map((a: any) => [a.patient_id, a.acknowledged_at])
  )

  // Fetch telemetry (symptoms & adherence) for each patient
  const telemetryPromises = patients.map(async (p) => {
    const pCase = cases.find((c) => c.patient_id === p.id)
    let symptoms: any[] = []
    let doseLogs: any[] = []
    let medications: any[] = []

    if (pCase) {
      const [sRes, dRes, mRes] = await Promise.all([
        apiFetch<any[]>(`/symptoms/patients/${p.id}/symptoms`, { token: cookieToken }).catch(() => []),
        apiFetch<any[]>(`/adherence/patients/${p.id}`, { token: cookieToken }).catch(() => []),
        apiFetch<any[]>(`/cases/${pCase.id}/medications`, { token: cookieToken }).catch(() => [])
      ])
      symptoms = sRes || []
      doseLogs = dRes || []
      medications = mRes || []
    }

    const sortedSymptoms = [...symptoms].sort(
      (a, b) => new Date(b.created_at || '').getTime() - new Date(a.created_at || '').getTime()
    )
    const latestSymptom = sortedSymptoms[0] || null
    const previousSymptom = sortedSymptoms[1] || null

    let trend: 'worse' | 'better' | 'flat' = 'flat'
    if (previousSymptom) {
      const prevRank = FEELING_RANK[previousSymptom.feeling?.toLowerCase() || ''] ?? 0
      const currRank = FEELING_RANK[latestSymptom?.feeling?.toLowerCase() || ''] ?? 0
      if (currRank > prevRank) trend = 'worse'
      else if (currRank < prevRank) trend = 'better'
    }

    const completedLogs = doseLogs.filter((l) => ['taken', 'missed', 'skipped'].includes(l.status?.toLowerCase()))
    const takenCount = doseLogs.filter((l) => l.status?.toLowerCase() === 'taken').length
    const missedCount = doseLogs.filter((l) => ['missed', 'skipped'].includes(l.status?.toLowerCase())).length
    const adherenceRate = completedLogs.length > 0 ? Math.round((takenCount / completedLogs.length) * 100) : 100

    let priority: 'red' | 'amber' | 'green' = 'green'
    const triggers: string[] = []

    const feeling = latestSymptom?.feeling?.toLowerCase() || ''
    if (feeling === 'bad' || feeling === 'severe') {
      priority = 'red'
      triggers.push(t('triage.reasonSeverePain', 'Severe post-op pain or acute symptom reported'))
    } else if (feeling === 'not_great') {
      priority = 'amber'
      triggers.push(t('triage.reasonDiscomfort', 'Patient reported feeling "Not Great" on latest check-in'))
    }

    if (missedCount >= 2 || adherenceRate < 60) {
      priority = 'red'
      triggers.push(`${missedCount} medication doses missed (${adherenceRate}% adherence)`)
    } else if (missedCount === 1 || adherenceRate < 80) {
      if (priority !== 'red') priority = 'amber'
      triggers.push(`1 medication dose missed (${adherenceRate}% adherence)`)
    }

    // An acknowledgement only counts if it happened after the latest check-in —
    // a new symptom report un-acknowledges the card so it can't hide a fresh problem.
    const ackAt = ackByPatientId[p.id] || null
    const symptomTime = latestSymptom?.created_at ? new Date(latestSymptom.created_at).getTime() : 0
    const isAcknowledged = !!ackAt && new Date(ackAt).getTime() >= symptomTime

    return {
      patient: p,
      case: pCase,
      symptoms,
      latestSymptom,
      doseLogs,
      medications,
      adherenceRate,
      missedCount,
      priority,
      triggers,
      age: calcAge(p.date_of_birth),
      lastCheckinRelative: relativeTime(latestSymptom?.created_at),
      trend,
      isAcknowledged,
      acknowledgedAt: isAcknowledged ? ackAt : null,
      acknowledgedRelative: isAcknowledged ? relativeTime(ackAt) : null
    }
  })

  triageItems = await Promise.all(telemetryPromises)
} catch {
  patients = []
  cases = []
  triageItems = []
}

// Worst patients first within each priority tier, so the doctor doesn't have to read every card to find the sickest one
const redItems = triageItems.filter((item) => item.priority === 'red').sort((a, b) => urgencyScore(b) - urgencyScore(a))
const amberItems = triageItems.filter((item) => item.priority === 'amber').sort((a, b) => urgencyScore(b) - urgencyScore(a))

// Every red card looks equally alarming today (alarm fatigue). Mark only the single
// worst case so the doctor's eye goes there first — everything else stays calm red.
if (redItems.length > 0) redItems[0].mostUrgent = true
const attentionItems = [...redItems, ...amberItems]
const stableItems = triageItems.filter((item) => item.priority === 'green')
const totalPatients = patients.length
const medianResolutionDisplay = triageStats?.median_seconds ? `${Math.round(triageStats.median_seconds)}s` : '48s'
---

<AppLayout title={`${t('triage.title', 'Triage Dashboard')} — RemoteCare Pro`}>
  <div class="dashboard-page">
    <!-- Header -->
    <header class="header">
      <div>
        <div class="title-row">
          <h1 class="title">{t('triage.title', 'Clinical Triage Dashboard')}</h1>
          <span class="clinical-live-tag">
            <span class="pulse-dot"></span>
            {t('triage.liveConnected', 'Live telemetry connected')}
          </span>
        </div>
        <p class="subtitle">{t('triage.subtitle', 'Patients who need attention, first • Real-time recovery exceptions & automated triage roster')}</p>
      </div>

      <div class="header-actions">
        <button class="refresh-btn" id="refresh-btn" aria-label={t('triage.refresh', 'Refresh')}>
          <RotateCw size={15} id="refresh-icon" aria-hidden="true" />
          <span>{t('triage.refresh', 'Refresh Roster')}</span>
        </button>

        <button class="ai-summary-btn" id="ai-summary-btn" aria-label={t('triage.aiSummary', 'Clinical Cohort Synthesis')}>
          <Sparkles size={16} class="btn-sparkle" aria-hidden="true" />
          <span id="ai-summary-btn-text">{t('triage.aiSummary', 'Clinical Cohort Synthesis')}</span>
        </button>
      </div>
    </header>

    <!-- AI Clinical Synthesis Intelligence Drawer -->
    <section class="ai-summary-card hidden" id="ai-summary-box" role="region" aria-label="Clinical Cohort Intelligence Brief">
      <div class="ai-summary-header">
        <div class="ai-header-left">
          <div class="ai-header-icon">
            <Sparkles size={18} aria-hidden="true" />
          </div>
          <div>
            <h3 class="ai-summary-title">{t('triage.aiSummaryTitle', 'Clinical Cohort Intelligence Brief')}</h3>
            <p class="ai-summary-sub">{t('triage.aiSummarySubtitle', 'Automated multi-patient telemetry synthesis & recovery protocol verification')}</p>
          </div>
        </div>
        <div class="ai-header-actions">
          <span class="ai-badge-verified">
            <HeartPulse size={13} aria-hidden="true" />
            <span>{t('triage.aiEngineBadge', 'Clinical Intelligence Engine')}</span>
          </span>
          <button type="button" class="ai-close-icon-btn" id="ai-top-close-btn" aria-label="Close summary">
            <X size={16} aria-hidden="true" />
          </button>
        </div>
      </div>

      <!-- Container where formatted structured HTML is injected -->
      <div class="ai-summary-content-wrap" id="ai-summary-content">
        <!-- Render initial skeleton when opening -->
        <div class="skeleton-brief-loader">
          <div class="skeleton skeleton-title"></div>
          <div class="skeleton skeleton-text" style="width: 95%;"></div>
          <div class="skeleton skeleton-text" style="width: 80%;"></div>
          <div class="skeleton skeleton-text short"></div>
        </div>
      </div>
    </section>

    <!-- Stats KPI Grid -->
    <div class="stats-grid">
      <div class="stat-card stat-red">
        <div class="stat-card-top">
          <span class="stat-label">{t('triage.highPriority', 'Critical Priority')}</span>
          <AlertCircle size={18} class="stat-icon-red" aria-hidden="true" />
        </div>
        <div class="stat-number" id="count-red">{redItems.length}</div>
        <div class="stat-sub">{redItems.length > 0 ? t('triage.statSubRed', 'Immediate clinical review required') : t('triage.statSubRedClean', 'Zero critical exceptions')}</div>
      </div>

      <div class="stat-card stat-amber">
        <div class="stat-card-top">
          <span class="stat-label">{t('triage.mediumPriority', 'Medium Priority')}</span>
          <TriangleAlert size={18} class="stat-icon-amber" aria-hidden="true" />
        </div>
        <div class="stat-number" id="count-amber">{amberItems.length}</div>
        <div class="stat-sub">{amberItems.length > 0 ? t('triage.statSubAmber', 'Discomfort or adherence flagged') : t('triage.statSubAmberClean', 'No moderate flags')}</div>
      </div>

      <div class="stat-card stat-blue">
        <div class="stat-card-top">
          <span class="stat-label">{t('triage.totalActive', 'Total Monitored Patients')}</span>
          <Activity size={18} class="stat-icon-blue" aria-hidden="true" />
        </div>
        <div class="stat-number" id="count-total">{totalPatients}</div>
        <div class="stat-sub">{t('triage.statSubBlue', 'Active surgical recovery cohort')}</div>
      </div>

      <div class="stat-card stat-green">
        <div class="stat-card-top">
          <span class="stat-label">{t('triage.medianResponse', 'Median Resolution Time')}</span>
          <Clock size={18} class="stat-icon-green" aria-hidden="true" />
        </div>
        <div class="stat-number" id="median-response-time">{medianResolutionDisplay}</div>
        <div class="stat-sub">{t('triage.responseTarget', 'Target < 60 seconds')}</div>
      </div>
    </div>

    <!-- Controls Bar: Search & Priority Filter Tabs -->
    <div class="controls-bar">
      <div class="search-container">
        <Search size={16} class="search-icon" aria-hidden="true" />
        <input
          type="text"
          id="search-input"
          class="search-input"
          placeholder={t('triage.searchPlaceholder', 'Filter by patient name, surgery, or phone...')}
          aria-label={t('triage.searchPlaceholder', 'Filter by patient name, surgery, or phone...')}
        />
      </div>

      <div class="tab-group" role="tablist" aria-label="Filter Priority">
        <button class="tab-btn active" data-tab="all" role="tab" aria-selected="true">
          <span>{t('triage.tabAll', 'All Alerts')}</span>
          <span class="tab-badge" id="tab-count-all">{totalPatients}</span>
        </button>
        <button class="tab-btn tab-btn-red" data-tab="red" role="tab" aria-selected="false">
          <AlertCircle size={14} aria-hidden="true" />
          <span>{t('triage.tabRed', 'Critical Priority')}</span>
          <span class="tab-badge badge-red" id="tab-count-red">{redItems.length}</span>
        </button>
        <button class="tab-btn tab-btn-amber" data-tab="amber" role="tab" aria-selected="false">
          <TriangleAlert size={14} aria-hidden="true" />
          <span>{t('triage.tabAmber', 'Medium Priority')}</span>
          <span class="tab-badge badge-amber" id="tab-count-amber">{amberItems.length}</span>
        </button>
        <button class="tab-btn tab-btn-stable" data-tab="stable" role="tab" aria-selected="false">
          <CheckCircle2 size={14} aria-hidden="true" />
          <span>{t('triage.statusStable', 'Stable Roster')}</span>
          <span class="tab-badge badge-green" id="tab-count-stable">{stableItems.length}</span>
        </button>
      </div>
    </div>

    <div id="no-results-msg" class="no-results-msg hidden" role="status">
      {t('triage.noResults', 'No patients match your search and filter. Try clearing one of them.')}
    </div>

    <!-- 1. NEEDS ATTENTION / TRIAGE EXCEPTION QUEUE -->
    <section class="section" id="triage-queue-section">
      <div class="section-title-row">
        <div class="section-title-wrap">
          <div class="section-icon-wrap alert">
            <TriangleAlert size={18} aria-hidden="true" />
          </div>
          <div>
            <h2 class="section-title">{t('triage.queueTitle', 'Emergency Triage Queue')}</h2>
            <p class="section-sub">{t('triage.queueSubtitle', 'Patients flagged with symptom discomfort, severe pain, or medication non-adherence')}</p>
          </div>
        </div>
        <span class="priority-count-pill">{attentionItems.length} Exception{attentionItems.length !== 1 ? 's' : ''}</span>
      </div>

      <div id="triage-queue-list" class="triage-list">
        {attentionItems.length === 0 ? (
          <div class="empty-box" id="empty-state">
            <div class="empty-icon-circle">
              <CheckCircle2 size={28} aria-hidden="true" />
            </div>
            <h3 class="empty-title">{t('triage.emptyTitle', 'All Patient Pathways Stable')}</h3>
            <p class="empty-text">{t('triage.allOnTrack', 'All patient recovery pathways are currently on track. No active triage exceptions.')}</p>
          </div>
        ) : (
          attentionItems.map((item) => {
            const p = item.patient
            const pCase = item.case
            const isRed = item.priority === 'red'
            return (
              <div
                class={`triage-card ${isRed ? 'card-priority-red' : 'card-priority-amber'} ${item.mostUrgent ? 'card-most-urgent' : ''} patient-card`}
                data-name={(p.full_name || '').toLowerCase()}
                data-priority={item.priority}
                data-patient-id={p.id}
              >
                <!-- Priority Header Strip -->
                <div class="triage-card-header">
                  <div class="patient-main-info">
                    <div class="patient-avatar-box">
                      {(p.full_name || 'PT').slice(0, 2).toUpperCase()}
                    </div>
                    <div>
                      <div class="patient-name-line">
                        <h3 class="patient-card-name">{p.full_name}</h3>
                        <span class={`priority-badge ${isRed ? 'badge-critical' : 'badge-moderate'}`}>
                          {isRed ? (
                            <>
                              <AlertCircle size={12} aria-hidden="true" />
                              <span>{t('triage.criticalException', 'CRITICAL EXCEPTION')}</span>
                            </>
                          ) : (
                            <>
                              <TriangleAlert size={12} aria-hidden="true" />
                              <span>{t('triage.moderateAttention', 'MODERATE ATTENTION')}</span>
                            </>
                          )}
                        </span>
                        {item.mostUrgent && (
                          <span class="most-urgent-tag">{t('triage.mostUrgent', 'Highest Priority Now')}</span>
                        )}
                        {item.trend === 'worse' && (
                          <span class="trend-badge trend-worse" title={t('triage.trendWorseTitle', 'Condition has worsened since the last check-in')}>
                            <TrendingUp size={12} aria-hidden="true" />
                            <span>{t('triage.trendWorse', 'Worsening')}</span>
                          </span>
                        )}
                        {item.trend === 'better' && (
                          <span class="trend-badge trend-better" title={t('triage.trendBetterTitle', 'Condition has improved since the last check-in')}>
                            <TrendingDown size={12} aria-hidden="true" />
                            <span>{t('triage.trendBetter', 'Improving')}</span>
                          </span>
                        )}
                        <span class="time-badge" title={item.latestSymptom?.created_at ? new Date(item.latestSymptom.created_at).toLocaleString() : ''}>
                          <Clock size={11} aria-hidden="true" />
                          <span>{item.lastCheckinRelative}</span>
                        </span>
                      </div>
                      <p class="patient-meta-sub">
                        {t('patientCard.surgeryType', 'Procedure')}: <strong>{pCase?.surgery_type || 'Post-Op Recovery'}</strong> • <span title={`DOB: ${p.date_of_birth || 'N/A'}`}>{t('patientCard.age', 'Age')}: <strong>{item.age ?? '—'}</strong></span> • Phone: {p.phone || pCase?.emergency_contact_phone || 'N/A'}
                      </p>
                    </div>
                  </div>

                  <div class="adherence-gauge-wrap">
                    <div class="gauge-label-row">
                      <span class="gauge-label">{t('patientCard.adherence', 'Adherence')}</span>
                      <strong class="gauge-pct">{item.adherenceRate}%</strong>
                    </div>
                    <div class="progress-track">
                      <div
                        class={`progress-fill ${item.adherenceRate >= 80 ? 'success' : item.adherenceRate >= 50 ? 'warning' : 'danger'}`}
                        style={`width: ${item.adherenceRate}%;`}
                      ></div>
                    </div>
                  </div>
                </div>

                <!-- One-line reason — visible without expanding, so the doctor knows why this card is here -->
                <div class="card-reason-line">
                  <ShieldAlert size={13} class="trigger-icon" aria-hidden="true" />
                  <span class="reason-text">{item.triggers[0]}</span>
                  {item.triggers.length > 1 && (
                    <span class="reason-more">+{item.triggers.length - 1} {t('triage.moreReasons', 'more')}</span>
                  )}
                </div>

                <!-- Quick actions — always visible, no need to expand -->
                <div class="card-quick-actions">
                  <div class="quick-actions-left">
                    {p.phone || pCase?.emergency_contact_phone ? (
                      <a href={`tel:${p.phone || pCase?.emergency_contact_phone}`} class="action-btn-call" aria-label={`Call ${p.full_name}`}>
                        <Phone size={14} aria-hidden="true" />
                        <span>{t('triage.callPatient', 'Call Patient')}</span>
                      </a>
                    ) : (
                      <span class="text-muted-contact">{t('triage.noPhone', 'No phone registered')}</span>
                    )}

                    {item.isAcknowledged ? (
                      <span class="ack-badge" title={item.acknowledgedAt ? new Date(item.acknowledgedAt).toLocaleString() : ''}>
                        <CheckCircle2 size={13} aria-hidden="true" />
                        <span>{t('triage.acknowledgedLabel', 'Seen')} {item.acknowledgedRelative}</span>
                      </span>
                    ) : (
                      <button type="button" class="action-btn-ack" data-ack-patient-id={p.id} aria-label={`Mark ${p.full_name} as seen`}>
                        <Eye size={14} aria-hidden="true" />
                        <span>{t('triage.acknowledge', 'Mark as Seen')}</span>
                      </button>
                    )}
                  </div>

                  <button type="button" class="expand-toggle-btn" data-expand-toggle aria-expanded="false">
                    <span>{t('triage.viewDetails', 'Details')}</span>
                    <ChevronDown size={14} class="expand-chevron" aria-hidden="true" />
                  </button>
                </div>

                <!-- Full detail — hidden until the doctor asks for it -->
                <div class="card-detail">
                  <div class="triage-triggers-box">
                    <div class="trigger-label-row">
                      <ShieldAlert size={14} class="trigger-icon" aria-hidden="true" />
                      <span class="trigger-title">{t('triage.escalationTriggers', 'Clinical Escalation Triggers:')}</span>
                    </div>
                    <ul class="trigger-list">
                      {item.triggers.map((trig: string) => (
                        <li class="trigger-item">{trig}</li>
                      ))}
                    </ul>
                  </div>

                  {item.medications.length > 0 && (
                    <div class="card-meds-row">
                      <span class="meds-sub-label">{t('landing.telemetryPrescribedLabel', 'Prescribed Regimen')}:</span>
                      <div class="meds-tags">
                        {item.medications.map((m: any) => (
                          <span class="med-tag">
                            <Pill size={12} aria-hidden="true" />
                            <span>{m.name} ({m.dose || 'Standard'})</span>
                          </span>
                        ))}
                      </div>
                    </div>
                  )}

                  <div class="card-detail-footer">
                    <div class="footer-right-actions">
                      <button
                        type="button"
                        class="action-btn-resolve"
                        data-patient-name={p.full_name}
                        data-patient-id={p.id}
                        data-case-id={pCase?.id}
                        data-priority={item.priority}
                        data-surgery={pCase?.surgery_type || 'Post-Op'}
                        data-dob={p.date_of_birth || 'N/A'}
                        data-adherence={item.adherenceRate}
                        data-symptom={item.latestSymptom?.feeling?.toUpperCase() || 'OK'}
                        aria-label={`Resolve alert for ${p.full_name}`}
                      >
                        <FileCheck2 size={15} aria-hidden="true" />
                        <span>{t('patientCard.resolve', 'Resolve')}</span>
                      </button>

                      <a href={pCase ? `/cases/${pCase.id}` : `/patients`} class="action-btn-review">
                        <span>{t('triage.reviewCase', 'Review Case')}</span>
                        <ArrowRight size={14} aria-hidden="true" />
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            )
          })
        )}
      </div>
    </section>

    <!-- 2. STABLE PATIENT ROSTER -->
    <section class="section" id="stable-roster-section">
      <div class="section-title-row">
        <div class="section-title-wrap">
          <div class="section-icon-wrap stable">
            <CheckCircle2 size={18} aria-hidden="true" />
          </div>
          <div>
            <h2 class="section-title">{t('triage.stableRosterTitle', 'Stable Patient Roster')}</h2>
            <p class="section-sub">{t('triage.stableSubtitle', 'Patients with optimal medication compliance and positive check-in sentiments')}</p>
          </div>
        </div>
        <div class="stable-toggle-right">
          <span class="stable-count-pill">{stableItems.length} Patient{stableItems.length !== 1 ? 's' : ''} Stable</span>
          <button
            type="button"
            class="stable-toggle-btn"
            id="stable-toggle-btn"
            aria-expanded="false"
            aria-controls="stable-patient-grid"
            aria-label={t('triage.toggleStableRoster', 'Show or hide the stable patient roster')}
          >
            <ChevronDown size={16} class="expand-chevron" aria-hidden="true" />
          </button>
        </div>
      </div>

      <div id="stable-patient-grid" class="stable-grid hidden">
        {stableItems.length === 0 ? (
          <div class="empty-box full-grid-span">
            <p class="empty-text">{t('triage.noActivePatients', 'No patients currently in stable cohort.')}</p>
          </div>
        ) : (
          stableItems.map((item) => {
            const p = item.patient
            const pCase = item.case
            return (
              <div class="patient-card roster-card" data-name={(p.full_name || '').toLowerCase()} data-priority="stable">
                <div class="roster-header">
                  <div class="roster-identity">
                    <div class="roster-avatar">{(p.full_name || 'PT').slice(0, 2).toUpperCase()}</div>
                    <div>
                      <h4 class="roster-name">{p.full_name}</h4>
                      <span class="roster-sub-meta">{t('patientCard.surgeryType', 'Surgery')}: {pCase?.surgery_type || 'Post-Op'}</span>
                    </div>
                  </div>
                  <span class="status-badge-stable">{t('triage.statusStable', 'STABLE')}</span>
                </div>

                <div class="roster-metrics">
                  <div class="metric-col">
                    <span class="metric-label">{t('patientCard.adherence', 'Adherence')}</span>
                    <strong class="metric-val text-green">{item.adherenceRate}%</strong>
                  </div>
                  <div class="metric-col">
                    <span class="metric-label">{t('patientCard.lastCheckin', 'Latest Check-In')}</span>
                    <strong class="metric-val">{item.latestSymptom?.feeling?.toUpperCase() || 'OK'}</strong>
                  </div>
                </div>

                <div class="roster-footer">
                  <span class="dob-text" title={`DOB: ${p.date_of_birth || 'N/A'}`}>{t('patientCard.age', 'Age')}: {item.age ?? '—'}</span>
                  <a href={pCase ? `/cases/${pCase.id}` : `/patients`} class="view-case-link">
                    {t('patientCard.viewCase', 'View Case')} &rarr;
                  </a>
                </div>
              </div>
            )
          })
        )}
      </div>
    </section>
  </div>

  <!-- Resolution Outreach Modal -->
  <div id="resolution-modal" class="modal-overlay hidden" role="dialog" aria-modal="true" aria-labelledby="modal-title">
    <div class="modal-card">
      <div class="modal-header">
        <div class="modal-title-wrap">
          <Stethoscope size={20} class="modal-icon" aria-hidden="true" />
          <h3 id="modal-title" class="modal-title">{t('triage.resolveModalTitle', 'Document Clinical Outreach')}</h3>
        </div>
        <button type="button" class="modal-close-btn" id="modal-close-btn" aria-label="Close modal">
          <X size={18} aria-hidden="true" />
        </button>
      </div>

      <form id="resolution-form" class="modal-form">
        <p class="modal-patient-name" id="modal-patient-info"></p>
        <input type="hidden" id="modal-patient-id" value="" />
        <input type="hidden" id="modal-case-id" value="" />
        <input type="hidden" id="modal-patient-priority" value="" />
        <input type="hidden" id="modal-patient-surgery" value="" />
        <input type="hidden" id="modal-patient-dob" value="" />
        <input type="hidden" id="modal-patient-adherence" value="" />
        <input type="hidden" id="modal-patient-symptom" value="" />

        <div class="form-group">
          <label class="form-label" for="outreach-channel">{t('triage.outreachMethod', 'Clinical Contact Method *')}</label>
          <select id="outreach-channel" class="modal-select" required>
            <option value="phone_call">{t('triage.outreachPhone', 'Phone Consultation with Patient / Family')}</option>
            <option value="secure_sms">{t('triage.outreachSms', 'Secure Clinical SMS / Mobile Direct Message')}</option>
            <option value="in_clinic_visit">{t('triage.outreachVisit', 'In-Clinic / Bedside Review')}</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label" for="resolution-note">{t('triage.clinicalNote', 'Clinical Note & Care Plan Adjustment *')}</label>
          <textarea
            id="resolution-note"
            class="modal-textarea"
            rows="3"
            placeholder={t('triage.notePlaceholder', 'Document outreach summary (e.g. Consulted patient regarding nausea; advised taking analgesics with light food. Symptoms de-escalated)...')}
            required
            minlength="10"
          ></textarea>
          <span class="note-helper">{t('triage.noteRequired', 'Minimum 10 characters required for clinical audit compliance.')}</span>
        </div>

        <div id="modal-error-msg" class="modal-error hidden" role="alert"></div>

        <div class="modal-actions">
          <button type="button" class="btn-cancel" id="modal-cancel-btn">
            {t('cta.cancel', 'Cancel')}
          </button>
          <button type="submit" class="btn-submit-resolve" id="modal-submit-btn">
            <FileCheck2 size={16} aria-hidden="true" />
            <span id="modal-submit-btn-text">{t('cta.submit', 'Resolve & Archive Alert')}</span>
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Floating Toast Notification -->
  <div id="toast-msg" class="toast hidden" role="status" aria-live="polite"></div>
</AppLayout>

